<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;published_*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.0.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.21" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PsychDashboard.Tests/**/*.cs" />
    <Compile Remove="TestConsole.cs;TestDump.cs;test_parse.cs" />
    <Content Remove="PsychDashboard.Tests/**" />
    <None Remove="PsychDashboard.Tests/**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="WINDOWS-SERVER-DEPLOYMENT.md" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
