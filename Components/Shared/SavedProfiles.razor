@using System.Text.Json
@inject IJSRuntime JS

<div class="saved-profiles">
    <label for="saved-profile">Saved profiles</label>
    <select id="saved-profile" @bind="_selectedId" @bind:after="OnProfileSelected" disabled="@(!_ready || _applying)">
        <option value="">Choose a profile</option>
        @foreach (var profile in _profiles.OrderBy(p => p.Name))
        {
            <option value="@profile.Id">@profile.Name — @(profile.Person ?? "any individual")</option>
        }
    </select>
    <button type="button" disabled="@(!_ready || !Enabled)" @onclick="() => BeginEdit(false)">Save current view</button>
    <button type="button" disabled="@(!CanApply)" @onclick="Update">Update</button>
    <button type="button" disabled="@(Selected == null)" @onclick="() => BeginEdit(true)">Rename</button>
    <button type="button" disabled="@(Selected == null)" @onclick="Delete">Delete</button>
    <span class="profile-hint">@(_ready ? $"{_profiles.Count} saved in this browser" : "Browser storage unavailable")</span>
    @if (Enabled && Selected?.Id == _appliedId && _snapshot != SettingsSnapshot())
    {
        <span class="profile-hint">Modified — choose Update to save changes</span>
    }
    @if (_ready && !Enabled && _profiles.Count > 0)
    {
        <span class="profile-hint">@_profiles.Count saved profile(s). Load a workbook to apply one.</span>
    }
    @if (Selected is { Person: not null } selected && (!Enabled || !MatchesPerson(selected)))
    {
        <span class="profile-hint">Load a workbook for @selected.Person to apply or update this profile.</span>
    }
    @if (_editing)
    {
        <div class="profile-editor">
            <label for="profile-name">Profile name</label>
            <input id="profile-name" maxlength="80" @bind="_name" placeholder="e.g. Weekend SCIP review" />
            @if (!_renaming)
            {
                <label><input type="checkbox" @bind="_individual" disabled="@(string.IsNullOrWhiteSpace(Person))" /> Only for this individual</label>
            }
            <button type="button" @onclick="Save">Save</button>
            <button type="button" @onclick="() => _editing = false">Cancel</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="profile-message" role="status">@_message</div>
    }
</div>

@code {
    [Parameter] public string? Person { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public Func<ViewProfile> Capture { get; set; } = default!;
    [Parameter] public EventCallback<ViewProfile> OnApply { get; set; }
    private const string StorageKey = "psych-dashboard.view-profiles.v1";
    private List<ViewProfile> _profiles = new();
    private bool _ready, _editing, _renaming, _individual, _applying;
    private string _selectedId = "", _name = "", _message = "";
    private string? _appliedId, _snapshot;
    private string SettingsSnapshot()
    {
        var settings = Capture();
        settings.Id = ""; settings.Name = ""; settings.Person = null;
        return JsonSerializer.Serialize(settings);
    }
    private void RememberApplied(string id)
    {
        _appliedId = id;
        _snapshot = SettingsSnapshot();
    }
    private ViewProfile? Selected => _profiles.FirstOrDefault(p => p.Id == _selectedId);
    private bool CanApply => Enabled && Selected is { } profile && MatchesPerson(profile);
    private bool MatchesPerson(ViewProfile p) => p.Person == null ||
        string.Equals(p.Person.Trim(), Person?.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            _profiles = json == null ? new() : JsonSerializer.Deserialize<List<ViewProfile>>(json) ?? throw new JsonException();
            if (_profiles.Any(p => p == null || string.IsNullOrWhiteSpace(p.Id) || string.IsNullOrWhiteSpace(p.Name)
                || p.Behaviors == null || p.Medications == null || p.Maneuvers == null || p.Days == null || p.Shifts == null
                || !Enum.IsDefined(p.Period) || !Enum.IsDefined(p.Measure) || !Enum.IsDefined(p.ChartType)
                || p.Days.Any(d => !Enum.IsDefined(d)) || p.Shifts.Any(shift => !new[] { "7-3", "3-11", "11-7" }.Contains(shift))
                || p.Behaviors.Values.Concat(p.Medications.Values).Any(v => v == null || v.Color == null)))
                throw new JsonException();
            _ready = true;
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            _profiles = new();
            _message = "Saved profiles could not be read. Browser storage may be blocked or damaged. Existing saved data has not been changed.";
        }
        StateHasChanged();
    }

    private void BeginEdit(bool rename)
    {
        _renaming = rename;
        _name = rename ? Selected?.Name ?? "" : "";
        _individual = !string.IsNullOrWhiteSpace(Person);
        _editing = true;
        _message = "";
    }

    private async Task<bool> Persist(List<ViewProfile> next)
    {
        try
        {
            var json = JsonSerializer.Serialize(next);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (stored != json)
            {
                _message = "The browser did not retain this profile. Please check site storage permissions before closing the page.";
                return false;
            }
            _profiles = next;
            return true;
        }
        catch (JSException)
        {
            _message = "Could not save profiles. Please allow browser storage and check that it is not full.";
            return false;
        }
    }

    private async Task Save()
    {
        var name = _name.Trim();
        if (name.Length == 0) { _message = "Enter a profile name."; return; }
        var person = _renaming ? Selected?.Person : _individual ? Person?.Trim() : null;
        if (_profiles.Any(p => p.Id != (_renaming ? _selectedId : "") &&
            string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(p.Person, person, StringComparison.OrdinalIgnoreCase)))
        { _message = "A profile with this name already exists. Choose another name or use Update."; return; }
        var profile = _renaming
            ? JsonSerializer.Deserialize<ViewProfile>(JsonSerializer.Serialize(Selected))!
            : Capture();
        if (profile == null) return;
        profile.Name = name;
        profile.Person = person;
        var next = _profiles.Where(p => p.Id != profile.Id).Append(profile).ToList();
        if (await Persist(next))
        {
            _selectedId = profile.Id; _editing = false;
            if (!_renaming) RememberApplied(profile.Id);
            _message = $"Saved “{name}”. Changes to the chart are saved only when you choose Update.";
        }
    }

    private async Task OnProfileSelected()
    {
        _editing = false;
        _message = "";
        if (!CanApply) return;
        _applying = true;
        try
        {
            await Apply();
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task Apply()
    {
        if (!CanApply || Selected is not { } profile) return;
        await OnApply.InvokeAsync(profile);
        RememberApplied(profile.Id);
        var current = Capture();
        var missing = profile.Behaviors.Keys.Except(current.Behaviors.Keys)
            .Concat(profile.Medications.Keys.Except(current.Medications.Keys))
            .Concat(profile.Maneuvers.Keys.Except(current.Maneuvers.Keys)).ToArray();
        _message = $"Applied “{profile.Name}”." + (missing.Length > 0
            ? $" Unavailable in this workbook: {string.Join(", ", missing)}. These remain saved in the profile." : "");
    }

    private async Task Update()
    {
        if (!CanApply || Selected is not { } previous) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Replace the settings in “{previous.Name}” with the current view?")) return;
        var profile = Capture();
        profile.Id = previous.Id; profile.Name = previous.Name; profile.Person = previous.Person;
        // Keep settings for variables absent from this year's workbook.
        foreach (var entry in previous.Behaviors) profile.Behaviors.TryAdd(entry.Key, entry.Value);
        foreach (var entry in previous.Medications) profile.Medications.TryAdd(entry.Key, entry.Value);
        foreach (var entry in previous.Maneuvers) profile.Maneuvers.TryAdd(entry.Key, entry.Value);
        if (await Persist(_profiles.Select(p => p.Id == profile.Id ? profile : p).ToList()))
        {
            RememberApplied(profile.Id);
            _message = $"Updated “{profile.Name}”.";
        }
    }

    private async Task Delete()
    {
        if (Selected is not { } profile) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete profile “{profile.Name}”?")) return;
        if (await Persist(_profiles.Where(p => p.Id != profile.Id).ToList()))
        { _selectedId = ""; _message = "Profile deleted."; }
    }
}
