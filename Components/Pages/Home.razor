    private async Task UploadWorkbooks(InputFileChangeEventArgs e)
    {
        const int maxWorkbookCount = 25;
        const long maxWorkbookSize = 10 * 1024 * 1024;
        IReadOnlyList<IBrowserFile> files;

        try
        {
            files = e.GetMultipleFiles(maxWorkbookCount);
        }
        catch (InvalidOperationException)
        {
            _uploadMessage = $"Select no more than {maxWorkbookCount} workbooks at once.";
            _uploadMessageColor = MudBlazor.Color.Error;
            return;
        }

        if (files.Count == 0) return;

        var invalidFile = files.FirstOrDefault(file =>
            !new[] { ".xlsx", ".xlsm", ".xls" }
                .Contains(Path.GetExtension(file.Name), StringComparer.OrdinalIgnoreCase));
        if (invalidFile != null)
        {
            _uploadMessage = $"{invalidFile.Name} is not a supported Excel workbook.";
            _uploadMessageColor = MudBlazor.Color.Error;
            return;
        }

        var oversizedFile = files.FirstOrDefault(file => file.Size > maxWorkbookSize);
        if (oversizedFile != null)
        {
            _uploadMessage = $"{oversizedFile.Name} exceeds the 10 MB workbook limit.";
            _uploadMessageColor = MudBlazor.Color.Error;
            return;
        }

        _uploadMessage = $"Parsing {files.Count} workbook{(files.Count == 1 ? "" : "s")}...";
        _uploadMessageColor = MudBlazor.Color.Info;
        StateHasChanged();

        try
        {
            var parsedBatch = new List<ParsedWorkbookResult>();
            foreach (var file in files)
            {
                using var stream = file.OpenReadStream(maxWorkbookSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                parsedBatch.Add(await ExcelParsingService.ParseWorkbookAsync(ms));
            }

            _parsedWorkbook = WorkbookMergeService.Merge(_parsedWorkbook, parsedBatch);
            foreach (var file in files)
            {
                _loadedWorkbookSignatures.Add(
                    $"{file.Name}|{file.Size}|{file.LastModified.UtcDateTime:O}");
            }

            _uploadMessage = BuildWorkbookSummary();
            _uploadMessageColor = MudBlazor.Color.Success;
            ClearChartZoomBaseline();
            _selectedResident = null;
            _useDataWarehouse = false;

            await LoadDefaultDateRangeAsync(showFullHistory: _loadedWorkbookSignatures.Count > 1);
            _renderedChartState = new ChartViewState(
                _chartType,
                _showIntensity,
                _showDuration,
                _showMedications,
                _showTrendLines);
            BuildChartOptions();
            // Workbook replacement changes every series and its option-array
            // indexes. Remount ApexCharts instead of updating the old JS
            // instance, which can otherwise retain a zero line stroke while
            // applying the new marker configuration.
            _chartRevision++;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("WorkbookUpload")
                .LogError(ex, "Workbook batch upload or parsing failed");
            _uploadMessage = "The workbooks could not be processed. No files from this batch were added.";
            _uploadMessageColor = MudBlazor.Color.Error;
            StateHasChanged();
        }
    }

    private async Task ClearWorkbooks()
    {
        ClearChartZoomBaseline();
        _parsedWorkbook = null;
        _loadedWorkbookSignatures.Clear();
        _uploadMessage = "";
        _selectedResident = null;
        await LoadDataAsync();
        BuildChartOptions();
        await RenderChart();
    }

    private string BuildWorkbookSummary()
    {
        if (_parsedWorkbook == null) return "";

        var datedRecords = _parsedWorkbook.Behaviors
            .Where(record => record.Date.HasValue)
            .Select(record => record.Date!.Value.Date)
            .ToList();
        var dateSummary = datedRecords.Count == 0
            ? ""
            : $" • {datedRecords.Min():MMM yyyy}–{datedRecords.Max():MMM yyyy}";

        return $"{_loadedWorkbookSignatures.Count} workbook{(_loadedWorkbookSignatures.Count == 1 ? "" : "s")} loaded" +
               dateSummary;
    }

    private async Task LoadDefaultDateRangeAsync(bool showFullHistory = false)
    {
        await LoadDataAsync();
        InitializeDefaultDateRange(showFullHistory);
        // The first load discovers the merged history bounds using the old
        // window. Rebuild the displayed data for the newly selected window.
        await LoadDataAsync(refreshNavigator: false);
    }

    private void InitializeDefaultDateRange(bool showFullHistory = false)
    {
        if (_viewModel != null && _viewModel.GlobalMaxDate.HasValue)
        {
            var max = _viewModel.GlobalMaxDate.Value;
            var min = showFullHistory && _viewModel.GlobalMinDate.HasValue
                ? _viewModel.GlobalMinDate.Value
                : max.AddYears(-1);
            if (_viewModel.GlobalMinDate.HasValue && min < _viewModel.GlobalMinDate.Value)
                min = _viewModel.GlobalMinDate.Value;
            _startDate = min;
            _endDate = max;
            _dateRange = new DateRange(min, max);
        }
    }

    private List<string> validMedsList = new List<string>();

    private string GetMedicationName(string seriesName)
    {
        return _viewModel?.AvailableMedications
            .OrderByDescending(name => name.Length)
            .FirstOrDefault(name =>
                seriesName.Equals(name, StringComparison.OrdinalIgnoreCase) ||
                seriesName.StartsWith($"{name} (", StringComparison.OrdinalIgnoreCase))
            ?? seriesName;
    }

    private Dictionary<string, string> BuildMedicationTooltipLookup(HashSet<string> allowedMeds)
    {
        var lookup = new Dictionary<string, string>();
        if (!_renderedChartState.ShowMedications || _viewModel == null) return lookup;

        var medicationsByDate = _viewModel.UnreducedMedications
            .Where(m => m.Dose > 0 && allowedMeds.Contains(m.Name))
            .GroupBy(m => m.Date.Date)
            .ToDictionary(group => group.Key, group => group
                .OrderByDescending(m => m.Dose)
                .ThenBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
                .ToList());

        // Match the plotted X coordinate: month index, rolling target, or UTC
        // timestamp. Cover the mounted history so navigator movement also works.
        foreach (var point in ChartBehaviorCounts)
        {
            if (!medicationsByDate.TryGetValue(point.Date.Date, out var medications)) continue;
            var key = _selectedPeriod switch
            {
                AggregationPeriod.Month => Convert.ToString(GetChartXValue(point), System.Globalization.CultureInfo.InvariantCulture)!,
                AggregationPeriod.Average => point.Target,
                _ => new DateTimeOffset(DateTime.SpecifyKind(point.Date, DateTimeKind.Utc))
                    .ToUnixTimeMilliseconds().ToString(System.Globalization.CultureInfo.InvariantCulture)
            };
            var rows = medications.Select(m =>
            {
                var name = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(m.Name);
                var unit = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(m.Unit ?? "");
                return $"<div style='font-size:11px;font-weight:normal;color:#555;'>{name}: <b>{m.Dose} {unit}</b></div>";
            });
            lookup[key] = "<div style='margin-top:6px;padding-top:6px;border-top:1px solid #ccc;'><b>Medications</b>" +
                string.Join("", rows) + "</div>";
        }
        return lookup;
    }

    private List<DailyBehaviorCount> BuildMedicationPlotData(string seriesName)
    {
        if (_viewModel == null) return new List<DailyBehaviorCount>();

        var medicationName = GetMedicationName(seriesName);
        var medicationData = _viewModel.UnreducedMedications
            .Where(item => item.Name.Equals(medicationName, StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.Date)
            .ToList();

        if (!medicationData.Any()) return new List<DailyBehaviorCount>();

        var chartMinDate = FilteredBehaviorCounts.Any()
            ? FilteredBehaviorCounts.Min(item => item.Date)
            : (_dateRange?.Start ?? DateTime.Today.AddDays(-30));
        var chartMaxDate = FilteredBehaviorCounts.Any()
            ? FilteredBehaviorCounts.Max(item => item.Date)
            : (_dateRange?.End ?? DateTime.Today);

        List<DateTime> datesToUse;
        if (_renderedChartState.ChartType == ChartDisplayType.Bar)
        {
            datesToUse = FilteredBehaviorCounts
                .Select(item => item.Date)
                .Distinct()
                .OrderBy(date => date)
                .ToList();
        }
        else
        {
            datesToUse = medicationData
                .Select(item => item.Date)
                .Where(date => date >= chartMinDate && date <= chartMaxDate)
                .Distinct()
                .ToList();

            if (!datesToUse.Contains(chartMinDate)) datesToUse.Add(chartMinDate);
            if (!datesToUse.Contains(chartMaxDate)) datesToUse.Add(chartMaxDate);
            datesToUse.Sort();
        }

        return datesToUse.Select(date =>
        {
            // UnreducedMedications contains one record for every active day.
            // An absent date therefore represents a zero dose, including gaps
            // and dates after a medication ended.
            var dose = medicationData.LastOrDefault(item => item.Date.Date == date.Date)?.Dose ?? 0;
            return new DailyBehaviorCount
            {
                Date = date,
                Target = seriesName,
                Rate = dose == 0 ? 0.1 : dose,
                HasData = true
            };
        }).ToList();
    }

    private List<DailyBehaviorCount> BuildTrendLineData(string target)
    {
        if (_selectedPeriod == AggregationPeriod.Average)
            return new List<DailyBehaviorCount>();
        if (!ChartBehaviorCounts.Any())
            return new List<DailyBehaviorCount>();

        // Use the same mounted aggregation that supplies the visible bars.
        // Filtering a separately re-aggregated view model can shift period
        // anchors and make a displayed bar appear to be omitted from the fit.
        var rangeStart = GetAggregatePeriodStart(
            (_startDate ?? _dateRange?.Start ?? ChartBehaviorCounts.Min(x => x.Date)).Date);
        var rangeEnd = (_endDate ?? _dateRange?.End ?? ChartBehaviorCounts.Max(x => x.Date))
            .Date.AddDays(1).AddTicks(-1);
        var visibleChartPoints = ChartBehaviorCounts
            .Where(item => item.Date >= rangeStart && item.Date <= rangeEnd)
            .ToList();

        // A period belongs in the trend when the workbook contains a recorded
        // observation, including an explicitly recorded all-zero period. Within
        // it, an absent target is a meaningful zero. Untouched workbook periods
        // are removed during ingestion and never reach this calculation.
        var observedDates = visibleChartPoints
            .Where(item => item.HasData)
            .Select(item => item.Date)
            .Distinct()
            .OrderBy(date => date)
            .ToList();

        var targetValuesByDate = visibleChartPoints
            .Where(item => item.Target == target && item.HasData)
            .GroupBy(item => item.Date)
            .ToDictionary(
                group => group.Key,
                group => _yAxisMetric == YAxisMetric.Rate
                    ? group.Sum(item => item.Rate)
                    : group.Sum(item => item.Count));

        var observations = observedDates.Select(date => (
            date,
            Value: targetValuesByDate.GetValueOrDefault(date, 0)));

        return LinearTrend.Calculate(observations)
            .Select(point => new DailyBehaviorCount
            {
                Date = point.Date,
                Target = $"{target} (Trend)",
                Rate = point.Value,
                HasData = true
            })
            .ToList();
    }

    // --- Chart Configuration ---
    private void BuildChartOptions()
    {
        var composition = ChartComposition;
        var isStacked = composition.IsStacked;
        var yAxisTitle = isStacked
            ? "Frequency (by metric level)"
            : (_yAxisMetric == YAxisMetric.Rate ? "Rate (avg. episodes/shift)" : "Frequency");

        var medNamesJson = System.Text.Json.JsonSerializer.Serialize(_viewModel?.AvailableMedications ?? new List<string>());

        var xMinDate = (_startDate ?? _dateRange?.Start)
            ?? (ChartBehaviorCounts.Any() ? ChartBehaviorCounts.Min(x => x.Date) : DateTime.Today.AddDays(-30));
        var xMaxDate = (_endDate ?? _dateRange?.End)
            ?? (ChartBehaviorCounts.Any() ? ChartBehaviorCounts.Max(x => x.Date) : DateTime.Today);
        var selectedMonthStart = new DateTime(xMinDate.Year, xMinDate.Month, 1);
        var selectedMonthEnd = new DateTime(xMaxDate.Year, xMaxDate.Month, 1);
        if (_selectedPeriod == AggregationPeriod.Month)
        {
            // Monthly values live on day one. Give the first and last points
            // symmetric space so neither boundary bar is clipped by the
            // literal date-range endpoints.
            xMinDate = selectedMonthStart.AddDays(-15);
            xMaxDate = selectedMonthEnd.AddDays(15);
        }

        int baseBehaviorSeriesCount = isStacked
            ? VisibleTargets.Sum(GetTargetOverlaySeriesCount)
            : VisibleTargets.Count;
        int behaviorSeriesCount = baseBehaviorSeriesCount;
        if (_renderedChartState.ShowIntensity && !isStacked) behaviorSeriesCount += VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Intensity && _targetsWithIntensityData.Contains(t)).Count(t => FilteredBehaviorCounts.Any(x => x.Target == t && x.AverageIntensity > 0));
        if (_renderedChartState.ShowDuration && !isStacked) behaviorSeriesCount += VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Duration && _targetsWithDurationData.Contains(t)).Count(t => FilteredBehaviorCounts.Any(x => x.Target == t && x.TotalDuration > 0));
        var trendTargets = _renderedChartState.ShowTrendLines
            ? VisibleTargets.Where(target => BuildTrendLineData(target).Count >= 2).ToList()
            : new List<string>();
        var trendSeriesCount = trendTargets.Count;

        var pointAnnotations = new List<AnnotationsPoint>();
        int medicationYAxisIndex = isStacked
            ? 1
            : behaviorSeriesCount + trendSeriesCount;

        double globalMaxMedDose = 1000d;
        double globalMinMedDose = 0.1d;
        var validMeds = new List<dynamic>();
        var visibleMedicationUnits = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        // Child parameters still describe the previous workbook until the next
        // render. Apply its visibility choices to the current model's names.
        var allowedMeds = (_viewModel?.AvailableMedications ?? new List<string>())
            .Where(med => _variableSelector?.IsMedicationVisible(med) ?? true)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // Always replace this render-derived list so a previous chart mode
        // cannot leak medication series into the next composition.
        validMedsList = new List<string>();
        if (composition.ShowMedicationSeries && _viewModel != null)
        {
            foreach (var med in _viewModel.AvailableMedications)
            {
                if (!allowedMeds.Contains(med)) continue;

                var medTransitions = _viewModel.DailyMedications
                    .Where(x => x.Name.Equals(med, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(x => x.Date)
                    .ToList();
                if (medTransitions.Any() && medTransitions.First().Date <= xMaxDate && medTransitions.Last().Date >= xMinDate)
                {
                    var unit = medTransitions
                        .Select(x => x.Unit?.Trim())
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
                    foreach (var medicationUnit in medTransitions
                        .Where(x => x.Date >= xMinDate && x.Date <= xMaxDate)
                        .Select(x => x.Unit?.Trim())
                        .Where(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        visibleMedicationUnits.Add(medicationUnit!);
                    }
                    var seriesName = string.IsNullOrWhiteSpace(unit) ? med : $"{med} ({unit})";
                    var viewTransitions = medTransitions.Where(x => x.Date >= xMinDate && x.Date <= xMaxDate).ToList();
                    var maxDoseInView = viewTransitions.Any() 
                        ? viewTransitions.Max(x => x.Dose) 
                        : (medTransitions.LastOrDefault(x => x.Date <= xMinDate)?.Dose ?? 0);

                    var minDoseInView = viewTransitions.Where(x => x.Dose > 0).Any()
                        ? viewTransitions.Where(x => x.Dose > 0).Min(x => x.Dose)
                        : (medTransitions.LastOrDefault(x => x.Date <= xMinDate && x.Dose > 0)?.Dose ?? 0);

                    validMeds.Add(new { Name = seriesName, MaxDose = maxDoseInView, MinDose = minDoseInView });
                }
            }

            var sortedMeds = validMeds.OrderByDescending(x => x.MaxDose).Select(x => (string)x.Name).ToList();
            validMedsList = sortedMeds;
            if (validMeds.Any())
            {
                var rawMin = validMeds.Where(x => x.MinDose > 0).Any() ? validMeds.Where(x => x.MinDose > 0).Min(x => (double)x.MinDose) : 0.1d;
                var rawMax = validMeds.Max(x => (double)x.MaxDose);
                if (rawMax == 0) rawMax = 1d; // Fallback
                if (rawMin == rawMax) {
                    rawMin = rawMin * 0.5;
                    rawMax = rawMax * 2.0;
                }
                globalMinMedDose = rawMin;
                globalMaxMedDose = rawMax;
            }
        }

        var strokeWidths = new List<double>();
        var strokeCurves = new List<Curve>();
        var strokeDashArrays = new List<double>();
        var behaviorMarkers = new List<MarkersDiscrete>();

        var isBarMode = _renderedChartState.ChartType == ChartDisplayType.Bar && !isStacked;
        var useExactBarHover = _renderedChartState.ChartType == ChartDisplayType.Bar;
        var behaviorCurve = Curve.Straight;
        // In bar mode, behavior series still need a value in the stroke array (ApexCharts requires one per series)
        // but they're bars so the actual stroke width doesn't matter — use 0
        var behaviorWidth = _renderedChartState.ChartType == ChartDisplayType.Line && !isStacked ? 2.5 : 0;

        for (int i = 0; i < behaviorSeriesCount; i++)
        {
            strokeWidths.Add(behaviorWidth);
            strokeCurves.Add(isBarMode ? Curve.Straight : behaviorCurve);
            strokeDashArrays.Add(10000); // 10000 prevents the stroke-dasharray="0" SVG invisible stroke bug!
        }

        // Disable Apex's shared line markers and opt only the primary behavior
        // series into markers. This prevents medication and overlay lines from
        // inheriting behavior marker styling.
        if (_renderedChartState.ChartType == ChartDisplayType.Line && !isStacked)
        {
            for (var seriesIndex = 0; seriesIndex < VisibleTargets.Count; seriesIndex++)
            {
                var target = VisibleTargets[seriesIndex];
                var targetColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";
                var pointCount = FilteredBehaviorCounts.Count(x => x.Target == target);
                for (var pointIndex = 0; pointIndex < pointCount; pointIndex++)
                {
                    behaviorMarkers.Add(new MarkersDiscrete
                    {
                        SeriesIndex = seriesIndex,
                        DataPointIndex = pointIndex,
                        Size = 4,
                        FillColor = targetColor,
                        StrokeColor = "#ffffff"
                    });
                }
            }
        }

        for (int i = 0; i < trendSeriesCount; i++)
        {
            strokeWidths.Add(2.5);
            strokeCurves.Add(Curve.Straight);
            strokeDashArrays.Add(6);
        }

        foreach (var med in validMedsList)
        {
            strokeWidths.Add(2.5);
            strokeCurves.Add(Curve.Stepline); // Staircase line for dose transitions
            strokeDashArrays.Add(2); // Dotted line
        }

        // Prevent ArgumentNullException in ApexCharts ValueOrListConverter for empty lists
        if (strokeWidths.Count == 0)
        {
            strokeWidths.Add(0);
            strokeCurves.Add(Curve.Straight);
            strokeDashArrays.Add(0);
        }

        var medLookupJson = System.Text.Json.JsonSerializer.Serialize(
            BuildMedicationTooltipLookup(allowedMeds));

        var rollingStart = _startDate ?? _dateRange?.Start
            ?? _viewModel?.UnreducedBehaviorCounts.Where(x => x.Date.HasValue).MinBy(x => x.Date)?.Date;
        var rollingEnd = _endDate ?? _dateRange?.End
            ?? _viewModel?.UnreducedBehaviorCounts.Where(x => x.Date.HasValue).MaxBy(x => x.Date)?.Date;
        var rollingRangeLabel = rollingStart.HasValue && rollingEnd.HasValue
            ? $"{rollingStart.Value:MMM d, yyyy} – {rollingEnd.Value:MMM d, yyyy}"
            : "Selected period";
        var rollingRangeLabelJson = System.Text.Json.JsonSerializer.Serialize(rollingRangeLabel);
        var weeklyRangeLookup = FilteredBehaviorCounts
            .Where(item => _selectedPeriod == AggregationPeriod.Week)
            .GroupBy(item => item.Date.Date)
            .ToDictionary(
                group => new DateTimeOffset(DateTime.SpecifyKind(group.Key, DateTimeKind.Utc)).ToUnixTimeMilliseconds(),
                group =>
                {
                    var end = group.Select(item => item.PeriodEnd.Date)
                        .Where(date => date >= group.Key)
                        .DefaultIfEmpty(group.Key.AddDays(6))
                        .Max();
                    return group.Key.Month == end.Month
                        ? $"{group.Key:MMM d}–{end:d, yyyy}"
                        : $"{group.Key:MMM d}–{end:MMM d, yyyy}";
                });
        var weeklyRangeLookupJson = System.Text.Json.JsonSerializer.Serialize(weeklyRangeLookup);
        var weeklyAxisRangeLookup = FilteredBehaviorCounts
            .Where(item => _selectedPeriod == AggregationPeriod.Week)
            .GroupBy(item => item.Date.Date)
            .ToDictionary(
                group => new DateTimeOffset(DateTime.SpecifyKind(group.Key, DateTimeKind.Utc)).ToUnixTimeMilliseconds(),
                group =>
                {
                    var end = group.Select(item => item.PeriodEnd.Date)
                        .Where(date => date >= group.Key)
                        .DefaultIfEmpty(group.Key.AddDays(6))
                        .Max();
                    var endText = group.Key.Month == end.Month ? $"{end:d}" : $"{end:MMM d}";
                    return $"{group.Key:MMM d}–{endText} ’{end:yy}";
                });
        var weeklyAxisRangeLookupJson = System.Text.Json.JsonSerializer.Serialize(weeklyAxisRangeLookup);
        var monthlyAxisLabelLookup = ChartBehaviorCounts
            .GroupBy(item => (item.Date.Year * 12 + item.Date.Month - 1) - NavigatorFirstMonthIndex)
            .ToDictionary(
                group => group.Key,
                group => group.Min(item => item.Date).ToString("MMM yyyy"));
        var monthlyAxisLabelLookupJson = System.Text.Json.JsonSerializer.Serialize(monthlyAxisLabelLookup);

        string? stackedBarTooltip = null;
        if (isStacked)
        {
            // The plotted overlay values may be rate-scaled, but tooltip values
            // report original counts. Group duplicate target/date records so
            // Rolling mode cannot terminate the circuit with duplicate keys.
            var overlayCountLookup = FilteredBehaviorCounts
                .GroupBy(item =>
                    $"{item.Target}|{GetChartXValue(item)}")
                .ToDictionary(
                    group => group.Key,
                    group =>
                    {
                        // Six bucket slots (duration uses all six), plus the
                        // original episode total used by the unavailable series.
                        var counts = new double[7];
                        foreach (var item in group)
                        {
                            var metric = GetTargetOverlayMetric(item.Target, _renderedChartState);
                            var buckets = metric == OverlayMetric.Intensity
                                ? item.IntensityBuckets.Take(IntensityLabels.Count)
                                : item.DurationBuckets.Take(DurationLabels.Count);
                            var index = 0;
                            foreach (var bucket in buckets)
                                counts[index++] += bucket;
                            counts[6] += item.Count;
                        }
                        return counts;
                    });
            var overlayCountLookupJson = System.Text.Json.JsonSerializer.Serialize(overlayCountLookup);

            stackedBarTooltip = @"function({series, seriesIndex, dataPointIndex, w}) {
            var names = w.globals.seriesNames || [];
            var hoveredName = names[seriesIndex] || '';
            var baseName = hoveredName
                .split(' Level ')[0]
                .split(' Duration ')[0]
                .split(' (Unspecified)')[0]
                .split(' Intensity unavailable')[0]
                .split(' Duration unavailable')[0];
            var hoveredX = w.globals.seriesX[seriesIndex]
                ? w.globals.seriesX[seriesIndex][dataPointIndex]
                : null;
            var rawCountsByPoint = " + overlayCountLookupJson + @";
            var rawCounts = hoveredX === null
                ? null
                : rawCountsByPoint[baseName + '|' + String(Number(hoveredX))];

            var escapeHtml = function(value) {
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/""/g, '&quot;')
                    .replace(/'/g, '&#039;');
            };

            var rows = [];
            var total = 0;

            for (var i = 0; i < names.length; i++) {
                var name = names[i] || '';
                var itemBase = name
                    .split(' Level ')[0]
                    .split(' Duration ')[0]
                    .split(' (Unspecified)')[0]
                    .split(' Intensity unavailable')[0]
                    .split(' Duration unavailable')[0];
                if (itemBase !== baseName) continue;

                var pointIndex = dataPointIndex;
                var xValues = w.globals.seriesX[i] || [];
                if (hoveredX !== null) {
                    var matchingIndex = xValues.findIndex(function(x) {
                        return Number(x) === Number(hoveredX);
                    });
                    if (matchingIndex >= 0) pointIndex = matchingIndex;
                }

                var value = series[i] ? series[i][pointIndex] : null;
                if (value === null || value === undefined || Number(value) <= 0) continue;

                var label = name.substring(baseName.length).trim();
                if (!label) label = name;
                var numericValue = Number(value);
                var bucketMatch = label.match(/(?:Level|Duration)\s+(\d+)/);
                // Intensity series names include the workbook bucket label for
                // internal mapping (for example Level 3: 3). The tooltip's
                // right column already reports the count, so keep the visible
                // row label concise and avoid repeating the level number.
                var displayLabel = label.replace(/^(Level\s+\d+):\s*\d+\s*$/, '$1');
                if (rawCounts && bucketMatch) {
                    var bucketIndex = Number(bucketMatch[1]) - 1;
                    if (bucketIndex >= 0 && bucketIndex < 6)
                        numericValue = Number(rawCounts[bucketIndex] || 0);
                } else if (rawCounts && label.toLowerCase().includes('unavailable')) {
                    numericValue = Number(rawCounts[6] || 0);
                }

                if (numericValue <= 0) continue;
                total += numericValue;
                rows.push({
                    label: displayLabel,
                    value: numericValue,
                    level: bucketMatch ? Number(bucketMatch[1]) : -1
                });
            }

            rows.sort(function(a, b) {
                return b.level - a.level;
            });

            var dateLabel = " + (_selectedPeriod == AggregationPeriod.Average ? rollingRangeLabelJson : "''") + @";
            if (!dateLabel && hoveredX !== null && !isNaN(Number(hoveredX))) {
                var hoveredDate = new Date(Number(hoveredX));
                if (" + (_selectedPeriod == AggregationPeriod.Month ? "true" : "false") + @") {
                    var monthLabels = " + monthlyAxisLabelLookupJson + @";
                    dateLabel = monthLabels[String(Number(hoveredX))] || '';
                } else if (" + (_selectedPeriod == AggregationPeriod.Week ? "true" : "false") + @") {
                    var weeklyRanges = " + weeklyRangeLookupJson + @";
                    var weeklyKeys = Object.keys(weeklyRanges);
                    var nearestKey = weeklyKeys.reduce(function(best, key) {
                        return best === null || Math.abs(Number(key) - Number(hoveredX)) < Math.abs(Number(best) - Number(hoveredX))
                            ? key : best;
                    }, null);
                    dateLabel = nearestKey === null ? '' : weeklyRanges[nearestKey];
                } else {
                    dateLabel = hoveredDate.toLocaleDateString('en-US', {
                        month: 'short',
                        year: 'numeric',
                        timeZone: 'UTC'
                    });
                }
            }

            var medicationNames = " + medNamesJson + @";
            var medicationBaseName = hoveredName.split(' (')[0];
            if (medicationNames.includes(medicationBaseName) || medicationNames.includes(hoveredName)) {
                var plottedDose = series[seriesIndex]
                    ? Number(series[seriesIndex][dataPointIndex])
                    : NaN;
                var dose = isNaN(plottedDose) ? 0 : Math.pow(10, plottedDose);
                if (dose <= 0.11) dose = 0;
                dose = Math.round(dose * 10) / 10;
                return '<div style=""min-width:180px;padding:10px 12px;"">' +
                    (dateLabel ? '<div style=""font-size:11px;color:#68757f;margin-bottom:2px;"">' + escapeHtml(dateLabel) + '</div>' : '') +
                    '<div style=""font-weight:700;margin-bottom:4px;"">' + escapeHtml(hoveredName) + '</div>' +
                    '<div>Dose: <strong>' + dose + '</strong></div></div>';
            }

            var formatValue = function(value) {
                return Math.round(value * 100) / 100;
            };

            var html = '<div style=""min-width:180px;padding:10px 12px;"">';
            if (dateLabel) {
                html += '<div style=""font-size:11px;color:#68757f;margin-bottom:2px;"">' +
                    escapeHtml(dateLabel) + '</div>';
            }
            html += '<div style=""font-weight:700;margin-bottom:7px;"">' +
                escapeHtml(baseName) + '</div>';

            for (var r = 0; r < rows.length; r++) {
                html += '<div style=""display:flex;align-items:center;gap:7px;margin:4px 0;"">' +
                    '<span style=""flex:1;"">' + escapeHtml(rows[r].label) + '</span>' +
                    '<strong>' + formatValue(rows[r].value) + '</strong></div>';
            }

            html += '<div style=""display:flex;justify-content:space-between;border-top:1px solid #e1e5e8;margin-top:7px;padding-top:7px;"">' +
                '<span style=""font-weight:600;"">Total</span><strong>' + formatValue(total) + '</strong></div>';
            var medLookup = " + medLookupJson + @";
            var medicationKey = " + (_selectedPeriod == AggregationPeriod.Average ? "baseName" : "String(hoveredX)") + @";
            html += medLookup[medicationKey] || '';
            html += '</div>';
            return html;
        }";
        }
        var xPaddingDays = _selectedPeriod switch {
                // Monthly points already sit on the first day of each recorded
                // month. Padding crosses into adjacent, unrecorded months and
                // causes Apex to label those boundaries as real periods.
                AggregationPeriod.Month => 0,
                AggregationPeriod.Week => 0,
                _ => 1
            };

            var xAxisFormat = _selectedPeriod switch {
                AggregationPeriod.Month => "MMM yyyy",
                _ => "dd MMM"
            };

            var xAxisLabelFormatter = _selectedPeriod switch
            {
                AggregationPeriod.Week => @"function(value, timestamp, opts) {
                        var rawValue = Number(timestamp === undefined ? value : timestamp);
                        var weeklyRanges = " + weeklyAxisRangeLookupJson + @";
                        var weeklyKeys = Object.keys(weeklyRanges);
                        var nearestKey = weeklyKeys.reduce(function(best, key) {
                            return best === null || Math.abs(Number(key) - rawValue) < Math.abs(Number(best) - rawValue)
                                ? key : best;
                        }, null);
                        return nearestKey === null ? value : weeklyRanges[nearestKey];
                    }",
                AggregationPeriod.Month => @"function(value, timestamp, opts) {
                        var labels = " + monthlyAxisLabelLookupJson + @";
                        var numeric = Number(value);
                        return Number.isInteger(numeric) ? (labels[String(numeric)] || '') : '';
                    }",
                _ => null
            };

            var tooltipXFormatter = _selectedPeriod switch
            {
                AggregationPeriod.Average => @"function(val, opts) { return '<b>' + " + rollingRangeLabelJson + @" + '</b>'; }",
                AggregationPeriod.Week => @"function(val, opts) {
                        var weeklyRanges = " + weeklyRangeLookupJson + @";
                        var weeklyKeys = Object.keys(weeklyRanges);
                        var nearestKey = weeklyKeys.reduce(function(best, key) {
                            return best === null || Math.abs(Number(key) - Number(val)) < Math.abs(Number(best) - Number(val))
                                ? key : best;
                        }, null);
                        var label = nearestKey === null ? '' : weeklyRanges[nearestKey];
                        return '<b>' + (label || '') + '</b>';
                    }",
                AggregationPeriod.Month => @"function(val, opts) {
                        var labels = " + monthlyAxisLabelLookupJson + @";
                        return '<b>' + (labels[String(Number(val))] || '') + '</b>';
                    }",
                _ => @"function(val, opts) {
                        var date = new Date(val);
                        var hour = date.getHours();
                        var shift = '';
                        if (hour === 7) shift = '7-3';
                        else if (hour === 15) shift = '3-11';
                        else if (hour === 23) shift = '11-7';
                        var options = { month: 'short', day: '2-digit', timeZone: 'UTC' };
                        var dateStr = date.toLocaleDateString('en-US', options);
                        var header = shift ? '<b>' + dateStr + ': ' + shift + ' Shift</b>' : '<b>' + dateStr + '</b>';

                        return header;
                    }"
            };

            // Use the same medication section for every ordinary tooltip,
            // including numeric month coordinates and rolling categories.
            tooltipXFormatter = @"function(val, opts) {
                var header = (" + tooltipXFormatter + @")(val, opts);
                var medLookup = " + medLookupJson + @";
                var meds = medLookup[String(val)];
                return header + (meds || '');
            }";

            var monthlyCategories = ChartBehaviorCounts
                .Select(item => item.Date.Date)
                .Distinct()
                .OrderBy(date => date)
                .Select(date => date.ToString("yyyy-MM"))
                .ToList();
            var monthlyStartKey = selectedMonthStart.ToString("yyyy-MM");
            var monthlyEndKey = selectedMonthEnd.ToString("yyyy-MM");
            var monthlyMinIndex = Math.Max(0, monthlyCategories.IndexOf(monthlyStartKey));
            var monthlyMaxIndex = monthlyCategories.IndexOf(monthlyEndKey);
            if (monthlyMaxIndex < monthlyMinIndex) monthlyMaxIndex = monthlyMinIndex;

            _options = new ApexChartOptions<DailyBehaviorCount>
            {
                Annotations = new Annotations { Points = pointAnnotations },
                Fill = new Fill { Opacity = 1.0 },
                Xaxis = new XAxis
                {
                    Type = _selectedPeriod switch
                    {
                        AggregationPeriod.Average => XAxisType.Category,
                        AggregationPeriod.Month => XAxisType.Numeric,
                        _ => XAxisType.Datetime
                    },
                    Labels = new XAxisLabels
                    {
                        Format = _selectedPeriod is AggregationPeriod.Week or AggregationPeriod.Month ? null : xAxisFormat,
                        Formatter = xAxisLabelFormatter,
                        DatetimeUTC = false,
                        ShowDuplicates = false
                    },
                    Min = _selectedPeriod switch
                    {
                        AggregationPeriod.Average => null,
                        AggregationPeriod.Month => monthlyMinIndex - 0.5,
                        _ => new DateTimeOffset(DateTime.SpecifyKind(isBarMode ? xMinDate.AddDays(-xPaddingDays) : xMinDate, DateTimeKind.Utc)).ToUnixTimeMilliseconds()
                    },
                    Max = _selectedPeriod switch
                    {
                        AggregationPeriod.Average => null,
                        AggregationPeriod.Month => monthlyMaxIndex + 0.5,
                        _ => new DateTimeOffset(DateTime.SpecifyKind(isBarMode ? xMaxDate.AddDays(xPaddingDays) : xMaxDate, DateTimeKind.Utc)).ToUnixTimeMilliseconds()
                    },
                    Tooltip = new AxisTooltip { Enabled = false }
                },
            Tooltip = new Tooltip
            {
                // Bar charts should respond only when the pointer is over an
                // actual bar. Shared nearest-X behavior can select the next
                // month while the pointer is still beside the previous bar.
                Intersect = useExactBarHover,
                Shared = !useExactBarHover,
                HideEmptySeries = true,
                InverseOrder = isStacked,
                X = new TooltipX
                {
                    Formatter = tooltipXFormatter
                },
                Y = new TooltipY
                {
                    Formatter = @"function(val, opts) {
                        if (val == undefined || val == null) return undefined;
                        var name = opts.w.globals.seriesNames[opts.seriesIndex];
                        var medNamesJson = " + medNamesJson + @";

                        if (name.includes(' Level ') || name.includes(' Duration ') || name.includes(' (Unspecified)')) {
                            var baseName = name;
                            if (name.includes(' Level ')) baseName = name.split(' Level ')[0];
                            else if (name.includes(' Duration ')) baseName = name.split(' Duration ')[0];
                            else if (name.includes(' (Unspecified)')) baseName = name.split(' (Unspecified)')[0];

                            var total = 0;
                            for (var i = 0; i < opts.w.globals.seriesNames.length; i++) {
                                var sName = opts.w.globals.seriesNames[i];
                                if (sName && (sName.startsWith(baseName + ' Level ') || sName.startsWith(baseName + ' Duration ') || sName === baseName + ' (Unspecified)')) {
                                    var sVal = opts.w.globals.series[i][opts.dataPointIndex];
                                    if (sVal) total += sVal;
                                }
                            }

                            var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                            return val + ' (' + pct + '%)';
                        }

                        var baseName = name.split(' (')[0];
                        if (medNamesJson.includes(baseName) || medNamesJson.includes(name)) {
                            var realVal = Math.pow(10, val);
                            if (realVal <= 0.11) return 0;
                            return Math.round(realVal * 10) / 10; 
                        }
                        return val;
                    }"
                }
            },
            Yaxis = new List<YAxis>(),
            Chart = new Chart
            {
                Id = "behavior-main-chart",
                // Viewport movement is driven directly in the browser by the
                // history navigator. Disabling transition animations keeps the
                // bars locked to the drag position instead of easing behind it.
                Animations = new Animations { Enabled = false },
                // ApexCharts requires a line base renderer for a mixed
                // line/column chart; individual behavior series still declare
                // themselves as bars.
                Type = (composition.ShowMedicationSeries && validMedsList.Any()) || trendSeriesCount > 0
                    ? ApexCharts.ChartType.Line
                    : (_renderedChartState.ChartType == ChartDisplayType.Bar
                        ? ApexCharts.ChartType.Bar
                        : ApexCharts.ChartType.Line),
                Toolbar = new Toolbar { Show = true },
                Zoom = new Zoom
                {
                    Enabled = true,
                    Type = AxisType.X,
                    AutoScaleYaxis = true
                },
                Stacked = isStacked,
                // Mixed charts should stack only the intensity/duration bars;
                // medication dose lines must remain independent.
                StackOnlyBar = composition.StackOnlyBars
            },
            Stroke = new Stroke
            {
                Curve = strokeCurves,
                Width = strokeWidths,
                DashArray = strokeDashArrays
            },
            Markers = new Markers
            {
                // Apex treats an exact numeric zero as an omitted/default value
                // in some mixed-series updates. A sub-pixel value reliably
                // suppresses all inherited line markers; behavior markers are
                // then restored explicitly through Discrete.
                Size = 0.001,
                StrokeWidth = 0,
                Hover = new MarkersHover
                {
                    Size = 0.001,
                    SizeOffset = 0
                },
                Discrete = behaviorMarkers
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    ColumnWidth = _selectedPeriod == AggregationPeriod.Average ? "40%" : "80%",
                    BorderRadius = 2,
                    HideZeroBarsWhenGrouped = true
                }
            },
            Legend = new Legend
            {
                Show = false,
                Position = LegendPosition.Bottom,
                HorizontalAlign = ApexCharts.Align.Center
            },

            DataLabels = new DataLabels { Enabled = false },
            Grid = new Grid
            {
                BorderColor = "#f0f0f0",
                StrokeDashArray = 4
            },
            States = new States
            {
                Hover = new StatesHover
                {
                    Filter = new StatesFilter { Type = StatesFilterType.none }
                }
            }
        };

        // Keep the two tooltip paths completely separate. ApexCharts treats the
        // presence of a null `custom` option as a formatter and attempts to call
        // it, which breaks ordinary charts. Only stacked overlay charts receive
        // the custom tooltip property at all.
        if (isStacked)
        {
            _options.Tooltip.Custom = stackedBarTooltip;
        }

        // 1. Behavior Axis templates
        var globalMax = 10m;
        if (ChartBehaviorCounts.Any())
        {
            var maxVal = ChartBehaviorCounts.Max(x => _yAxisMetric == YAxisMetric.Rate ? (decimal)x.Rate : x.Count);
            if (_yAxisMetric == YAxisMetric.Rate)
            {
                globalMax = maxVal > 0 ? maxVal * 1.1m : 1m;
            }
            else
            {
                globalMax = Math.Max(10m, Math.Ceiling(maxVal * 1.1m)); // 10% padding
            }
        }

        var firstStackedTarget = Enumerable.Reverse(VisibleTargets).FirstOrDefault();
        var firstStackedMetric = firstStackedTarget == null
            ? OverlayMetric.None
            : GetTargetOverlayMetric(firstStackedTarget, _renderedChartState);
        var firstBehaviorName = isStacked && firstStackedTarget != null
            ? $"{firstStackedTarget} " + (firstStackedMetric == OverlayMetric.Duration ? "Duration 1" : "Level 1")
            : VisibleTargets.FirstOrDefault();

        var behaviorAxis = new YAxis
        {
            SeriesName = firstBehaviorName ?? "Behavior",
            Title = new AxisTitle { Text = yAxisTitle },
            Min = 0,
            Max = globalMax,
            ForceNiceScale = true,
            Labels = new YAxisLabels { Formatter = @"function(val) { return Math.round(val * 100) / 100; }" },
            DecimalsInFloat = 0
        };
        var hiddenBehaviorAxis = new YAxis { Show = false, SeriesName = firstBehaviorName ?? "Behavior" };

        if (isStacked)
        {
            var stackedBehaviorSeriesNames = new List<string>();
            foreach (var target in Enumerable.Reverse(VisibleTargets))
            {
                var metric = GetTargetOverlayMetric(target, _renderedChartState);
                if (metric == OverlayMetric.Intensity)
                {
                    for (var level = 0; level < IntensityLabels.Count; level++)
                        stackedBehaviorSeriesNames.Add($"{target} Level {level + 1}: {IntensityLabels[level]}");
                    stackedBehaviorSeriesNames.Add($"{target} Intensity unavailable");
                }
                else if (metric == OverlayMetric.Duration)
                {
                    for (var level = 0; level < DurationLabels.Count; level++)
                        stackedBehaviorSeriesNames.Add($"{target} Duration {level + 1}: {DurationLabels[level]}");
                    stackedBehaviorSeriesNames.Add($"{target} Duration unavailable");
                }
            }
            stackedBehaviorSeriesNames.AddRange(trendTargets.Select(target => $"{target} (Trend)"));
            behaviorAxis.SeriesName = stackedBehaviorSeriesNames.Count > 0
                ? stackedBehaviorSeriesNames
                : new List<string> { "Behavior" };
            _options.Yaxis.Add(behaviorAxis);
        }
        else
        {
            var firstBehavior = VisibleTargets.FirstOrDefault() ?? "Behavior";
            behaviorAxis.SeriesName = firstBehavior;
            _options.Yaxis.Add(behaviorAxis);

            foreach (var target in VisibleTargets.Skip(1))
                _options.Yaxis.Add(new YAxis { Show = false, SeriesName = target, Min = 0, Max = globalMax });

            if (_renderedChartState.ShowIntensity)
                foreach (var t in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Intensity && _targetsWithIntensityData.Contains(t)))
                    if (FilteredBehaviorCounts.Any(x => x.Target == t && x.AverageIntensity > 0))
                        _options.Yaxis.Add(new YAxis { Show = false, SeriesName = $"{t} (Severity)", Min = 0, Max = globalMax });

            if (_renderedChartState.ShowDuration)
                foreach (var t in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Duration && _targetsWithDurationData.Contains(t)))
                    if (FilteredBehaviorCounts.Any(x => x.Target == t && x.TotalDuration > 0))
                        _options.Yaxis.Add(new YAxis { Show = false, SeriesName = $"{t} (Duration)", Min = 0, Max = globalMax });
        }


        // Stacked overlays and their trends intentionally share the behavior
        // axis above. Separate per-trend axes trigger an Apex 4.7 series-axis
        // mapping failure when grouped stacks are present.
        foreach (var target in isStacked ? Enumerable.Empty<string>() : trendTargets)
        {
            _options.Yaxis.Add(new YAxis
            {
                Show = false,
                SeriesName = $"{target} (Trend)",
                Min = 0,
                Max = globalMax
            });
        }

        // 2. Medication Axis — Dynamic log scale based on visible meds
        if (composition.ShowMedicationSeries && validMedsList.Any())
        {
            var logMin = Math.Log10(globalMinMedDose > 0 ? globalMinMedDose : 0.1);
            var logMax = Math.Log10(globalMaxMedDose > 0 ? globalMaxMedDose : 1);
            var pad = (logMax - logMin) * 0.1;
            if (pad == 0) pad = 0.5;
            var finalMin = (decimal)(logMin - pad);
            var finalMax = (decimal)(logMax + pad);

            var orderedMedicationUnits = visibleMedicationUnits
                .OrderBy(unit => unit.Equals("mg", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(unit => unit, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var medicationAxisTitle = orderedMedicationUnits.Count == 0
                ? "Medication Dose"
                : $"Medication Dose ({string.Join("/", orderedMedicationUnits)})";

            // All medication series use one shared right-hand scale. ApexCharts
            // can bind multiple series names to one axis, whereas creating one
            // axis per medication can crash its mixed stacked-chart mapper.
            _options.Yaxis.Add(new YAxis
            {
                SeriesName = validMedsList,
                Opposite = true,
                Title = new AxisTitle { Text = medicationAxisTitle },
                Labels = new YAxisLabels
                {
                    Formatter = @"function(val) {
                        var dose = Math.pow(10, val);
                        if (dose <= 0.11) return '0';
                        return dose.toLocaleString('en-US', { maximumSignificantDigits: 3 });
                    }"
                },
                // More reference points on the log scale, without rounding
                // fractional doses to whole numbers.
                TickAmount = 12,
                AxisTicks = new AxisTicks { Show = true },
                ForceNiceScale = false,
                DecimalsInFloat = 2,
                Min = finalMin,
                Max = finalMax
            });
        }

        // Ensure at least one axis if empty
        if (_options.Yaxis.Count == 0) _options.Yaxis.Add(behaviorAxis);





        // Apply colors — build per-series color list matching the exact order of series rendered
        var baseColors = new List<string>();

        if (isStacked)
        {
            foreach (var target in Enumerable.Reverse(VisibleTargets))
            {
                var targetColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";

                var targetMetric = GetTargetOverlayMetric(target, _renderedChartState);
                if (targetMetric == OverlayMetric.Intensity)
                {
                    var grad = GenerateGradient(targetColor, IntensityLabels.Count);
                    baseColors.AddRange(grad);
                    baseColors.Add(targetColor); // Fallback color
                }
                else if (targetMetric == OverlayMetric.Duration)
                {
                    var grad = GenerateGradient(targetColor, DurationLabels.Count);
                    baseColors.AddRange(grad);
                    baseColors.Add(targetColor); // Fallback color
                }
                else
                {
                    baseColors.Add(targetColor);
                }
            }

            foreach (var target in trendTargets)
                baseColors.Add(_variableSelector?.GetTargetColor(target) ?? "#2196F3");

            foreach (var medicationSeries in validMedsList)
            {
                var medicationName = GetMedicationName(medicationSeries);
                baseColors.Add(_variableSelector?.GetMedicationColor(medicationName) ?? "#3e2723");
            }
            _options.Colors = baseColors;
        }
        else
        {
            foreach (var target in VisibleTargets)
            {
                baseColors.Add(_variableSelector?.GetTargetColor(target) ?? "#2196F3");
            }

            // Add overlay colors for line mode (only for targets that actually have data)
            if (_renderedChartState.ShowIntensity)
                foreach (var t in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Intensity && _targetsWithIntensityData.Contains(t)))
                    if (FilteredBehaviorCounts.Any(x => x.Target == t && x.AverageIntensity > 0))
                    {
                        baseColors.Add("#FF9800");
                    }
            if (_renderedChartState.ShowDuration)
                foreach (var t in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Duration && _targetsWithDurationData.Contains(t)))
                    if (FilteredBehaviorCounts.Any(x => x.Target == t && x.TotalDuration > 0))
                    {
                        baseColors.Add("#00BCD4");
                    }

            foreach (var target in trendTargets)
                baseColors.Add(_variableSelector?.GetTargetColor(target) ?? "#2196F3");

            // Add dark colors for medications
            if (_renderedChartState.ShowMedications)
            {
                foreach (var medicationSeries in validMedsList)
                {
                    var medicationName = GetMedicationName(medicationSeries);
                    baseColors.Add(_variableSelector?.GetMedicationColor(medicationName) ?? "#3e2723");
                }
            }

            _options.Colors = baseColors;
        }

        if (_options.Fill == null) _options.Fill = new Fill { Opacity = 1.0 };

        // Add annotations
        var annotations = new Annotations { Xaxis = new List<AnnotationsXAxis>() };

        // Intervention annotations
        foreach (var intervention in _interventions)
        {
            annotations.Xaxis.Add(new AnnotationsXAxis
            {
                X = GetAnnotationXValue(intervention.Date),
                BorderColor = intervention.Color,
                StrokeDashArray = 4,
                Label = new Label
                {
                    Text = intervention.Label,
                    Style = new Style
                    {
                        Color = "#fff",
                        Background = intervention.Color,
                        FontSize = "11px"
                    }
                }
            });
        }

        // Missing data annotations
        if (_showMissingData && _viewModel?.MissingDataRanges != null)
        {
            foreach (var range in _viewModel.MissingDataRanges)
            {
                annotations.Xaxis.Add(new AnnotationsXAxis
                {
                    X = GetAnnotationXValue(range.Start),
                    X2 = GetAnnotationXValue(range.End.AddDays(1)),
                    FillColor = "#9E9E9E",
                    Opacity = 0.15d,
                    Label = new Label
                    {
                        Text = range.Reason,
                        Style = new Style
                        {
                            Color = "#757575",
                            Background = "transparent",
                            FontSize = "10px"
                        }
                    }
                });
            }
        }

        // Medication Transition Annotations
        annotations.Points = new List<AnnotationsPoint>();
        if (composition.ShowMedicationSeries && validMedsList.Any())
        {
            for (int medIndex = 0; medIndex < validMedsList.Count; medIndex++)
            {
                var seriesName = validMedsList[medIndex];
                var med = GetMedicationName(seriesName);
                var medColor = _variableSelector != null ? _variableSelector.GetMedicationColor(med) : "#3e2723";
                var unreducedMedData = _viewModel.UnreducedMedications
                    .Where(x => x.Name.Equals(med, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(x => x.Date)
                    .ToList();
                var datesToUse = FilteredBehaviorCounts.Select(x => x.Date).Distinct().ToList();
                if (_renderedChartState.ChartType != ChartDisplayType.Bar)
                {
                    datesToUse.AddRange(unreducedMedData.Select(x => x.Date));
                }
                datesToUse = datesToUse.Distinct().OrderBy(d => d).ToList();

                for (int j = 1; j < datesToUse.Count; j++)
                {
                    var previousDate = datesToUse[j - 1];
                    var currentDate = datesToUse[j];

                    var previousDose = unreducedMedData.LastOrDefault(x => x.Date <= previousDate)?.Dose ?? 0;
                    var currentDose = unreducedMedData.LastOrDefault(x => x.Date <= currentDate)?.Dose ?? 0;

                    if (previousDose > 0 && currentDose > 0 && currentDose != previousDose)
                    {
                        var isIncrease = currentDose > previousDose;
                        var symbol = isIncrease ? "▲" : "▼";

                        // Apex's stepline turns at the new point's X coordinate.
                        // Center the arrow on that vertical segment, halfway
                        // between the old and new logarithmic doses.
                        var previousLogY = Math.Log10((double)previousDose);
                        var currentLogY = Math.Log10((double)currentDose);
                        var logY = (previousLogY + currentLogY) / 2d;
                        var markerDate = currentDate;

                        annotations.Points.Add(new AnnotationsPoint
                        {
                            X = GetAnnotationXValue(markerDate),
                            Y = logY,
                            YAxisIndex = medicationYAxisIndex,
                            Marker = new AnnotationMarker { Size = 0 },
                            Label = new Label
                            {
                                Text = symbol,
                                // Apex positions label text above its Y anchor.
                                // Shift the larger glyph down so its center lies
                                // directly over the medication's vertical step.
                                OffsetY = 18,
                                BorderWidth = 0,
                                Style = new Style 
                                { 
                                    Color = medColor, 
                                    Background = "transparent", 
                                    FontSize = "20px"
                                }
                            }
                        });
                    }
                }
            }
        }

        _options.Annotations = annotations;
        BuildNavigatorOptions();
    }

    private void BuildNavigatorOptions()
    {
        if (!NavigatorBehaviorCounts.Any())
        {
            _navigatorOptions = null;
            return;
        }

        var fullStart = NavigatorBehaviorCounts.Min(item => item.Date).Date;
        var fullEnd = NavigatorBehaviorCounts
            .Select(item => item.PeriodEnd >= item.Date ? item.PeriodEnd.Date : item.Date.Date)
            .Max();
        static long UnixMilliseconds(DateTime value) =>
            new DateTimeOffset(DateTime.SpecifyKind(value.Date, DateTimeKind.Utc)).ToUnixTimeMilliseconds();

        _navigatorOptions = new ApexChartOptions<DailyBehaviorCount>
        {
            Chart = new Chart
            {
                Id = "behavior-history-navigator",
                Type = ApexCharts.ChartType.Line,
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                // The navigator points are anchored on the first day of each
                // aggregate month. Padding around those actual points prevents
                // the July and June endpoint labels from being clipped.
                Min = UnixMilliseconds(fullStart.AddDays(-15)),
                Max = UnixMilliseconds(NavigatorBehaviorCounts.Max(item => item.Date).Date.AddDays(15)),
                Labels = new XAxisLabels
                {
                    DatetimeUTC = false,
                    Format = fullEnd.Year == fullStart.Year ? "MMM" : "MMM 'yy"
                },
                Tooltip = new AxisTooltip { Enabled = false }
            },
            Yaxis = new List<YAxis>
            {
                new() { Show = false }
            },
            Stroke = new Stroke { Width = new List<double> { 2 }, Curve = Curve.Smooth },
            Markers = new Markers { Size = 0 },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend { Show = false },
            Tooltip = new Tooltip { Enabled = false },
            Grid = new Grid
            {
                Show = false,
                Padding = new Padding { Left = 4, Right = 4, Top = 0, Bottom = -8 }
            }
        };
    }

    private async Task RenderChart()
    {
        if (_chart != null)
        {
            try
            {
                await _chart.RenderAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser navigated away while a render was queued.
            }
            catch (Exception ex)
            {
                LoggerFactory.CreateLogger("ChartRendering")
                    .LogWarning(ex, "Chart render failed");
            }
        }
    }

    private async Task ExportToPdf()
    {
        var dateRangeText = _dateRange?.Start != null && _dateRange?.End != null
            ? $"{_dateRange.Start.Value:MMM dd, yyyy} – {_dateRange.End.Value:MMM dd, yyyy}"
            : "All dates";

        var behaviorSummary = VisibleTargets.Select(target =>
        {
            var points = FilteredBehaviorCounts
                .Where(item => item.Target == target && item.HasData)
                .OrderBy(item => item.Date)
                .ToList();
            var intensityBuckets = points.SelectMany(item => item.IntensityBuckets.Select((count, index) => new { count, index }));
            var intensityCount = intensityBuckets.Sum(item => item.count);
            var weightedIntensity = intensityBuckets.Sum(item => item.count * (item.index + 1));

            return new
            {
                Behavior = target,
                TotalEpisodes = points.Sum(item => item.Count),
                MeanRate = points.Count == 0 ? 0 : Math.Round(points.Average(item => item.Rate), 2),
                RecordedPeriods = points.Count,
                AverageIntensity = intensityCount > 0 ? Math.Round(weightedIntensity / intensityCount, 2) : (double?)null,
                TotalDuration = Math.Round(points.Sum(item => item.TotalDuration), 1),
                FirstPeriod = points.FirstOrDefault()?.Date.ToString("MMM d, yyyy") ?? "—",
                LastPeriod = points.LastOrDefault()?.Date.ToString("MMM d, yyyy") ?? "—"
            };
        }).ToList();

        var chartDates = FilteredBehaviorCounts.Select(item => item.Date.Date).ToList();
        var chartStart = chartDates.Count > 0 ? chartDates.Min() : (DateTime?)null;
        var chartEnd = chartDates.Count > 0 ? chartDates.Max() : (DateTime?)null;
        var medicationSummary = (_viewModel?.UnreducedMedications ?? new())
            .Where(item => (!chartStart.HasValue || item.Date.Date >= chartStart) &&
                           (!chartEnd.HasValue || item.Date.Date <= chartEnd))
            .GroupBy(item => item.Name)
            .Select(group => new
            {
                Medication = group.Key,
                DoseRange = $"{group.Min(item => item.Dose):0.##}–{group.Max(item => item.Dose):0.##} {group.First().Unit}".Trim(),
                Start = group.Min(item => item.Date).ToString("MMM d, yyyy"),
                End = group.Max(item => item.Date).ToString("MMM d, yyyy")
            })
            .OrderBy(item => item.Medication)
            .ToList();

        var summary = new
        {
            Resident = _chartTitle,
            DateRange = dateRangeText,
            DataCoverage = chartStart.HasValue && chartEnd.HasValue
                ? $"{chartStart.Value:MMM d, yyyy} – {chartEnd.Value:MMM d, yyyy}"
                : "No recorded data",
            Grouping = _selectedPeriod.ToString(),
            Measure = _yAxisMetric.ToString(),
            View = _chartType.ToString(),
            Shifts = string.Join(", ", _selectedShifts.OrderBy(shift => shift)),
            Overlays = string.Join(", ", new[]
            {
                _renderedChartState.ShowIntensity ? "Intensity" : null,
                _renderedChartState.ShowDuration ? "Duration" : null,
                _renderedChartState.ShowMedications ? "Medication" : null,
                _renderedChartState.ShowTrendLines ? "Trend line" : null,
                _showMissingData ? "Missing data" : null
            }.Where(value => value != null)),
            TotalEpisodes = behaviorSummary.Sum(item => item.TotalEpisodes),
            Behaviors = behaviorSummary,
            Medications = medicationSummary,
            MissingData = (_viewModel?.MissingDataRanges ?? new())
                .Where(range => (!chartStart.HasValue || range.End >= chartStart) &&
                                (!chartEnd.HasValue || range.Start <= chartEnd))
                .Select(range => new
                {
                    range.Reason,
                    Start = range.Start.ToString("MMM d, yyyy"),
                    End = range.End.ToString("MMM d, yyyy")
                })
                .ToList()
        };

        await JS.InvokeVoidAsync("chartExport.exportToPdf", _chartTitle, dateRangeText, summary);
    }

    private List<string> GenerateGradient(string baseHex, int steps)
    {
        var result = new List<string>();
        if (steps <= 1)
        {
            result.Add(baseHex);
            return result;
        }
        if (string.IsNullOrEmpty(baseHex) || !baseHex.StartsWith("#"))
        {
            for (int i = 0; i < steps; i++) result.Add("#2196F3");
            return result;
        }

        try
        {
            int r = Convert.ToInt32(baseHex.Substring(1, 2), 16);
            int g = Convert.ToInt32(baseHex.Substring(3, 2), 16);
            int b = Convert.ToInt32(baseHex.Substring(5, 2), 16);

            // We want a gradient from a very light version to the base color (or slightly darker)
            // Or better: Light -> Dark centered around base color
            for (int i = 0; i < steps; i++)
            {
                // Factor ranges from 0.3 (light) to 1.1 (darker)
                double factor = 1.6 - (i * (1.2 / (steps - 1)));

                int nr = Math.Clamp((int)(r * factor), 0, 255);
                int ng = Math.Clamp((int)(g * factor), 0, 255);
                int nb = Math.Clamp((int)(b * factor), 0, 255);

                // If factor is high (>1.0), we might want to blend with white instead for "light"
                // Let's try a different approach: Blend with white for top steps, then with black for bottom steps
                double t = (double)i / (steps - 1);
                // t=0: lightest, t=1: darkest

                // Mix base with white for light end (t=0) and black for dark end (t=1)
                // Let's say t=0.7 is the base color
                double baseAt = 0.7;
                int finalR, finalG, finalB;

                if (t < baseAt) {
                    // Blend between White (1.0) and Base (baseAt)
                    double subT = t / baseAt; // 0 to 1
                    finalR = (int)(255 + (r - 255) * (0.3 + 0.7 * subT));
                    finalG = (int)(255 + (g - 255) * (0.3 + 0.7 * subT));
                    finalB = (int)(255 + (b - 255) * (0.3 + 0.7 * subT));
                } else {
                    // Blend between Base (baseAt) and Darker
                    double subT = (t - baseAt) / (1.0 - baseAt);
                    finalR = (int)(r * (1.0 - 0.4 * subT));
                    finalG = (int)(g * (1.0 - 0.4 * subT));
                    finalB = (int)(b * (1.0 - 0.4 * subT));
                }

                result.Add($"#{Math.Clamp(finalR, 0, 255):X2}{Math.Clamp(finalG, 0, 255):X2}{Math.Clamp(finalB, 0, 255):X2}");
            }
        }
        catch
        {
            for (int i = 0; i < steps; i++) result.Add(baseHex);
        }

        return result;
    }
    private decimal? GetOverlayYValue(DailyBehaviorCount e, int bucketLevel, bool isIntensity)
    {
        double bucketCount = isIntensity ? (e.IntensityBuckets != null && e.IntensityBuckets.Length > bucketLevel ? e.IntensityBuckets[bucketLevel] : 0) : (e.DurationBuckets != null && e.DurationBuckets.Length > bucketLevel ? e.DurationBuckets[bucketLevel] : 0);
        if (bucketCount == 0 || e.Count == 0) return null;

        return _yAxisMetric == YAxisMetric.Rate
            ? (decimal)(bucketCount * (e.Rate / e.Count))
            : (decimal)bucketCount;
    }

    private decimal? GetBehaviorYValue(DailyBehaviorCount e)
    {
        if (!e.HasData) return null;

        var value = _yAxisMetric == YAxisMetric.Rate
            ? (decimal)Math.Round(e.Rate, 3)
            : e.Count;

        // ApexCharts can still draw a zero-height bar shape, particularly when
        // rounded borders are enabled. Omit zero values from bar series entirely.
        return _renderedChartState.ChartType == ChartDisplayType.Bar && value == 0 ? null : value;
    }

    private decimal? GetOverlayUnknownYValue(DailyBehaviorCount e, bool isIntensity)
    {
        if (!e.HasData || e.Count == 0) return null;

        var hasMetricData = isIntensity
            ? e.IntensityBuckets?.Any(value => value > 0) == true
            : e.DurationBuckets?.Any(value => value > 0) == true;

        if (hasMetricData) return null;

        return _yAxisMetric == YAxisMetric.Rate
            ? (decimal)Math.Round(e.Rate, 3)
            : e.Count;
    }
    private DailyBehaviorCount? _hoveredPoint;
    private string? _hoveredDateString;
    private string? _hoveredTarget;
    private List<KeyValuePair<string, int>> _hoveredSubcategories = new();
    private List<KeyValuePair<int, int>> _hoveredIntensities = new();
    private List<KeyValuePair<int, int>> _hoveredDurations = new();
    private string HoveredTargetColor => !string.IsNullOrWhiteSpace(_hoveredTarget)
        ? _variableSelector?.GetTargetColor(_hoveredTarget) ?? "#2196F3"
        : "#2196F3";

    private Task OnChartHover(HoverData<DailyBehaviorCount> args)
    {
        var hoveredSeriesName = args.Series?.Name;
        var hoveredTarget = GetBaseTargetName(hoveredSeriesName);
        var hoveredDate = GetHoveredDate(args.DataPoint?.X);

        // Stacked intensity/duration series are sparse because empty buckets are
        // rendered as null. Resolve the model from the hovered X value rather than
        // relying on DataPoint.Items, whose index can drift across sparse series.
        var item = hoveredDate.HasValue && !string.IsNullOrEmpty(hoveredTarget)
            ? FilteredBehaviorCounts.FirstOrDefault(x =>
                x.Target == hoveredTarget && x.Date.Date == hoveredDate.Value.Date)
            : null;

        // Category-based charts do not expose a date-valued X coordinate.
        item ??= args.DataPoint?.Items?.FirstOrDefault(x =>
            x.Target == hoveredTarget && x.HasData);

        if (item == null || string.IsNullOrEmpty(item.Target) || item.Target.Contains(" (mg)") || item.HasData == false)
            return Task.CompletedTask;

        _hoveredPoint = item;
        _hoveredTarget = item.Target;

        var date = item.Date;
        if (_selectedPeriod == AggregationPeriod.Month)
            _hoveredDateString = date.ToString("MMM yyyy");
        else if (_selectedPeriod == AggregationPeriod.Average)
        {
            var rangeStart = _startDate ?? _dateRange?.Start ?? date;
            var rangeEnd = _endDate ?? _dateRange?.End ?? date;
            _hoveredDateString = $"{rangeStart:MMM d, yyyy} – {rangeEnd:MMM d, yyyy}";
        }
        else if (_selectedPeriod == AggregationPeriod.Day)
            _hoveredDateString = date.ToString("dd MMM yyyy");
        else if (_selectedPeriod == AggregationPeriod.Week)
        {
            var weekStart = date.Date;
            var weekEnd = item.PeriodEnd >= weekStart ? item.PeriodEnd.Date : weekStart.AddDays(6);
            _hoveredDateString = weekStart.Month == weekEnd.Month
                ? $"{weekStart:MMM d}–{weekEnd:d, yyyy}"
                : $"{weekStart:MMM d}–{weekEnd:MMM d, yyyy}";
        }
        else
            _hoveredDateString = date.ToString("dd MMM yyyy");

        DateTime periodStart = date;
        DateTime periodEnd = date;

        switch (_selectedPeriod)
        {
            case AggregationPeriod.Month:
                periodStart = new DateTime(date.Year, date.Month, 1);
                periodEnd = periodStart.AddMonths(1).AddDays(-1);
                break;
            case AggregationPeriod.Week:
                periodStart = date.Date;
                periodEnd = item.PeriodEnd >= periodStart
                    ? item.PeriodEnd.Date
                    : periodStart.AddDays(6);
                break;
            case AggregationPeriod.Day:
                periodStart = date.Date;
                periodEnd = date.Date;
                break;
            case AggregationPeriod.Average:
                periodStart = (_startDate ?? _dateRange?.Start ?? date).Date;
                periodEnd = (_endDate ?? _dateRange?.End ?? date).Date;
                break;
        }

        var baseTarget = item.Target.Split(" Level ")[0].Split(" Duration ")[0].Split(" (Severity)")[0].Split(" (Duration)")[0];

        var rawRecords = _viewModel.UnreducedBehaviorCounts
            .Where(x => x.Target == baseTarget && x.Date?.Date >= periodStart && x.Date?.Date <= periodEnd)
            .ToList();

        var allSubs = rawRecords
            .Where(x => !string.IsNullOrEmpty(x.Subcategory))
            .SelectMany(x => x.Subcategory.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Where(x => !x.Equals("Not Specified", StringComparison.OrdinalIgnoreCase))
            .ToList();

        _hoveredSubcategories = allSubs
            .GroupBy(x => x)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Value)
            .ToList();

        _hoveredIntensities = new List<KeyValuePair<int, int>>
        {
            new(1, (int)rawRecords.Sum(x => x.Intensity_01_Count ?? 0)),
            new(2, (int)rawRecords.Sum(x => x.Intensity_02_Count ?? 0)),
            new(3, (int)rawRecords.Sum(x => x.Intensity_03_Count ?? 0)),
            new(4, (int)rawRecords.Sum(x => x.Intensity_04_Count ?? 0)),
            new(5, (int)rawRecords.Sum(x => x.Intensity_05_Count ?? 0))
        };

        _hoveredDurations = new List<KeyValuePair<int, int>>
        {
            new(1, (int)rawRecords.Sum(x => x.Duration_01_Count ?? 0)),
            new(2, (int)rawRecords.Sum(x => x.Duration_02_Count ?? 0)),
            new(3, (int)rawRecords.Sum(x => x.Duration_03_Count ?? 0)),
            new(4, (int)rawRecords.Sum(x => x.Duration_04_Count ?? 0)),
            new(5, (int)rawRecords.Sum(x => x.Duration_05_Count ?? 0)),
            new(6, (int)rawRecords.Sum(x => x.Duration_06_Count ?? 0))
        };

        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private static string? GetBaseTargetName(string? seriesName)
    {
        if (string.IsNullOrWhiteSpace(seriesName)) return null;

        return seriesName
            .Split(" Level ")[0]
            .Split(" Duration ")[0]
            .Split(" (Severity)")[0]
            .Split(" (Duration)")[0]
            .Split(" Intensity unavailable")[0];
    }

    private static DateTime? GetHoveredDate(object? xValue)
    {
        if (xValue == null) return null;
        if (xValue is DateTime date) return date;
        if (xValue is DateTimeOffset offset) return offset.UtcDateTime;

        if (xValue is System.Text.Json.JsonElement json)
        {
            if (json.ValueKind == System.Text.Json.JsonValueKind.Number &&
                json.TryGetInt64(out var unixMilliseconds))
            {
                return DateTimeOffset.FromUnixTimeMilliseconds(unixMilliseconds).UtcDateTime;
            }

            if (json.ValueKind == System.Text.Json.JsonValueKind.String)
                return ParseHoveredDate(json.GetString());
        }

        return ParseHoveredDate(Convert.ToString(xValue, System.Globalization.CultureInfo.InvariantCulture));
    }

    private static DateTime? ParseHoveredDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        if (long.TryParse(value, out var unixMilliseconds))
        {
            try
            {
                return DateTimeOffset.FromUnixTimeMilliseconds(unixMilliseconds).UtcDateTime;
            }
            catch (ArgumentOutOfRangeException)
            {
                return null;
            }
        }

        return DateTime.TryParse(
            value,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal,
            out var date)
                ? date
                : null;
    }
