@page "/"
@using ApexCharts
@using PsychDashboard.ViewModels
@using PsychDashboard.Services
@using PsychDashboard.Models
@using PsychDashboard.Components.Shared
@implements IDisposable

@inject PatientHistoryService PatientHistoryService
@inject IJSRuntime JS
@inject ExcelParsingService ExcelParsingService
@inject ILoggerFactory LoggerFactory

<MudAppBar Elevation="0" Class="dashboard-header">
    <MudImage Src="images/logo.png" Height="44" ObjectFit="ObjectFit.Contain" Class="mr-3" />
    <MudText Typo="Typo.h6" Class="app-title">Psychology Visualization Tool</MudText>
    <MudSpacer />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.body2" Style="font-weight: 600; color: #555;">Data Source:</MudText>
            <MudToggleGroup T="bool" SelectionMode="SelectionMode.SingleSelection" Value="_useDataWarehouse" ValueChanged="OnDataSourceChanged" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" CheckMark="true" Style="background-color: #f5f5f5; border-radius: 4px;">
                <MudToggleItem Value="false" Text="Local Workbook" />
                <MudToggleItem Value="true" Text="Data Warehouse" />
            </MudToggleGroup>
        </MudStack>

        @if (!_useDataWarehouse)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="workbook-import-controls">
                <div class="workbook-drop-zone">
                    <InputFile id="fileInput"
                               OnChange="UploadWorkbooks"
                               accept=".xlsm,.xlsx,.xls"
                               multiple
                               class="workbook-file-input" />
                    <MudIcon Icon="@Icons.Material.Filled.FileUpload" Size="MudBlazor.Size.Small" />
                    <span>Drop workbooks here</span>
                    <span class="workbook-drop-separator">or</span>
                    <span class="workbook-upload-button">Choose files</span>
                </div>
                @if (_parsedWorkbook != null)
                {
                    <MudTooltip Text="Clear loaded workbooks">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Default"
                                       OnClick="ClearWorkbooks" />
                    </MudTooltip>
                }
                @if (!string.IsNullOrEmpty(_uploadMessage))
                {
                    <MudText Typo="Typo.caption" Color="@_uploadMessageColor" Class="workbook-upload-message">@_uploadMessage</MudText>
                }
            </MudStack>
        }
    </MudStack>
</MudAppBar>

<MudButton Variant="Variant.Outlined"
           Size="MudBlazor.Size.Small"
           StartIcon="@(_filtersOpen ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
           OnClick="@(() => _filtersOpen = !_filtersOpen)"
           Class="mobile-filter-button">
    @(_filtersOpen ? "Hide filters" : "Show filters")
</MudButton>

<MudGrid Spacing="2" Class="dashboard-grid">

    @* ===== LEFT SIDEBAR: Variable Selector + Interventions ===== *@
    <MudItem xs="12" md="3" lg="2" Class="@($"filters-sidebar {(_filtersOpen ? "" : "filters-collapsed")}")">
        <MudStack Spacing="3" Style="flex-grow: 1; min-height: 0;">
            @if (_viewModel != null)
            {
                <div style="flex-shrink: 0;">
                    <VariableSelector @ref="_variableSelector"
                                      AvailableTargets="SortedAvailableTargets"
                                      AvailableSubcategories="_viewModel.AvailableSubcategories"
                                      ShowIntensity="_showIntensity"
                                      ShowIntensityChanged="OnShowIntensityChanged"
                                      ShowDuration="_showDuration"
                                      ShowDurationChanged="OnShowDurationChanged"
                                      OverlayMetricsDisabled="@(_chartType == ChartDisplayType.Line)"
                                      AvailableMedications="_viewModel.AvailableMedications"
                                      ShowMedications="_showMedications"
                                      ShowMedicationsChanged="OnShowMedicationsChanged"
                                      OnStateChanged="OnVariableStateChanged" />
                </div>

                @* <InterventionManager @bind-Interventions="_interventions" /> *@
                @* Removed temporarily per user request to save space *@

                @* Hover Tooltip Panel *@
                @if (_hoveredPoint != null)
                {
                    <MudPaper Class="pa-3 mt-2" Elevation="2" Style="border-radius: 8px; border: 1px solid #ccc; background-color: #fafafa; flex-grow: 1; min-height: 0; overflow-y: auto;">
                        <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; text-align: center;">@_hoveredDateString</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight: 600; display: block; text-align: center; margin-bottom: 8px;">@_hoveredTarget</MudText>

                        <MudDivider Class="mb-2" />
                        <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; text-align: center; margin-bottom: 4px;">Subcategories (shift)</MudText>
                        @if (_hoveredSubcategories.Any())
                        {
                            var maxSub = _hoveredSubcategories.Max(x => x.Value);
                            <MudStack Spacing="1">
                                @foreach (var sub in _hoveredSubcategories)
                                {
                                    <div style="display: flex; align-items: center; gap: 4px; font-size: 0.7rem;">
                                        <div style="flex: 1; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@sub.Key">
                                            @sub.Key
                                        </div>
                                        <div style="flex: 2; display: flex; align-items: center;">
                                            <div style="width: @(maxSub > 0 ? (sub.Value * 100.0 / maxSub) : 0)%; background-color: @HoveredTargetColor; height: 12px;"></div>
                                            <span style="margin-left: 4px;">@sub.Value</span>
                                        </div>
                                    </div>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="display: block; text-align: center; color: #888;">No Data</MudText>
                        }

                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; text-align: center; margin-bottom: 4px;">Intensity (episode)</MudText>
                        @if (_hoveredIntensities.Any())
                        {
                            var maxInt = _hoveredIntensities.Max(x => x.Value);
                            var intensityGradient = GenerateGradient(HoveredTargetColor, IntensityLabels.Count);
                            <div style="display: flex; justify-content: space-around; align-items: flex-end; height: 60px; padding: 0 10px;">
                                @for (int i = 1; i <= IntensityLabels.Count; i++)
                                {
                                    var val = _hoveredIntensities.FirstOrDefault(x => x.Key == i).Value;
                                    <div style="display: flex; flex-direction: column; align-items: center; width: 20px;">
                                        <span style="font-size: 0.65rem; margin-bottom: 2px;">@(val > 0 ? val.ToString() : "")</span>
                                        <div style="width: 100%; background-color: @intensityGradient[i - 1]; height: @(maxInt > 0 ? (val * 40.0 / maxInt) : 0)px;"></div>
                                        <span title="@IntensityLabels[i - 1]" style="font-size: 0.7rem; font-weight: 600; margin-top: 2px; border-top: 1px solid #ccc; width: 100%; text-align: center;">@i</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="display: block; text-align: center; color: #888;">No Data</MudText>
                        }

                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; text-align: center; margin-bottom: 4px;">Duration (episode)</MudText>
                        @if (_hoveredDurations.Any(x => x.Value > 0))
                        {
                            var maxDuration = _hoveredDurations.Max(x => x.Value);
                            var durationGradient = GenerateGradient(HoveredTargetColor, DurationLabels.Count);
                            <div style="display: flex; justify-content: space-around; align-items: flex-end; height: 60px; padding: 0 6px;">
                                @for (int i = 1; i <= DurationLabels.Count; i++)
                                {
                                    var val = _hoveredDurations.FirstOrDefault(x => x.Key == i).Value;
                                    <div style="display: flex; flex-direction: column; align-items: center; width: 18px;">
                                        <span style="font-size: 0.65rem; margin-bottom: 2px;">@(val > 0 ? val.ToString() : "")</span>
                                        <div style="width: 100%; background-color: @durationGradient[i - 1]; height: @(maxDuration > 0 ? (val * 40.0 / maxDuration) : 0)px;"></div>
                                        <span title="@DurationLabels[i - 1]" style="font-size: 0.65rem; font-weight: 600; margin-top: 2px; border-top: 1px solid #ccc; width: 100%; text-align: center;">@i</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="display: block; text-align: center; background-color: #eee; border: 1px solid #ccc; border-radius: 4px; padding: 2px; margin: 0 20px;">No Data</MudText>
                        }
                    </MudPaper>
                }
            }
        </MudStack>
    </MudItem>

    @* ===== MAIN CHART AREA ===== *@
    <MudItem xs="12" md="9" lg="10" Style="display: flex; flex-direction: column; height: calc(100vh - 80px); min-height: 400px;">
        <MudPaper Class="pa-3 d-flex flex-column chart-card" Elevation="0">
            @* --- Toolbar Row 1: Title + Controls --- *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="chart-heading-row">
                <div>
                    <MudText Typo="Typo.overline" Class="chart-eyebrow">Behavior overview</MudText>
                    <MudText Typo="Typo.h5" Class="chart-title">@_chartTitle</MudText>
                </div>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="view-actions">
                    @* Chart Type Toggle *@
                    <div class="control-group">
                        <span class="control-label">View</span>
                        <MudToggleGroup T="ChartDisplayType" SelectionMode="SelectionMode.SingleSelection"
                                        Value="_chartType" ValueChanged="OnChartTypeChanged"
                                        Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small"
                                        CheckMark="false" Class="d-flex">
                            <MudToggleItem Value="ChartDisplayType.Line" Text="Line" />
                            <MudToggleItem Value="ChartDisplayType.Bar" Text="Bar" />
                        </MudToggleGroup>
                    </div>

                    @* Y-Axis Metric Toggle *@
                    <div class="control-group">
                        <span class="control-label">Measure</span>
                        <MudToggleGroup T="YAxisMetric" SelectionMode="SelectionMode.SingleSelection"
                                        Value="_yAxisMetric" ValueChanged="OnYAxisMetricChanged"
                                        Color="MudBlazor.Color.Dark" Size="MudBlazor.Size.Small"
                                        CheckMark="false" Class="d-flex">
                            <MudToggleItem Value="YAxisMetric.Frequency" Text="Frequency" />
                            <MudToggleItem Value="YAxisMetric.Rate" Text="Rate" />
                        </MudToggleGroup>
                    </div>

                    <MudButton Variant="Variant.Outlined"
                               Size="MudBlazor.Size.Small"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="ExportToPdf"
                               Color="MudBlazor.Color.Default">
                        PDF
                    </MudButton>
                </MudStack>
            </MudStack>

            @* --- Toolbar Row 2: Aggregation + Shifts | Overlays | ID Select + Dates --- *@
            <div class="dashboard-toolbar">

                @* LEFT: Aggregation period + shift chips *@
                <div class="control-group">
                    <span class="control-label">Time grouping</span>
                    <MudToggleGroup T="AggregationPeriod" SelectionMode="SelectionMode.SingleSelection"
                                    Value="_selectedPeriod" ValueChanged="OnPeriodChanged"
                                    Color="MudBlazor.Color.Dark" Size="MudBlazor.Size.Small"
                                    CheckMark="false" Class="d-flex">
                        <MudToggleItem Value="AggregationPeriod.Day" Text="Day" />
                        <MudToggleItem Value="AggregationPeriod.Week" Text="Week" />
                        <MudToggleItem Value="AggregationPeriod.Month" Text="Month" />
                        <MudToggleItem Value="AggregationPeriod.Average" Text="Rolling" />
                    </MudToggleGroup>
                </div>

                <div class="control-group">
                    <span class="control-label">Shifts</span>
                    <MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedShifts"
                                SelectedValuesChanged="OnShiftSelectionChanged"
                                CheckMark="true" Color="MudBlazor.Color.Default" Variant="Variant.Outlined">
                        <MudChip T="string" Value="@("7-3")" Size="MudBlazor.Size.Small" Default="true">7–3</MudChip>
                        <MudChip T="string" Value="@("3-11")" Size="MudBlazor.Size.Small" Default="true">3–11</MudChip>
                        <MudChip T="string" Value="@("11-7")" Size="MudBlazor.Size.Small" Default="true">11–7</MudChip>
                    </MudChipSet>
                </div>

                @* CENTER: Medication + Missing Data Toggles *@
                <div class="control-group overlays-group">
                    <span class="control-label">Optional overlays</span>
                    <div class="overlay-controls">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSwitch T="bool" Value="_showMedications" ValueChanged="OnShowMedicationsChanged" Color="MudBlazor.Color.Info" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.caption" Class="toggle-label" @onclick="() => OnShowMedicationsChanged(!_showMedications)">Medication</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSwitch T="bool" Value="_showMissingData" ValueChanged="OnMissingDataChanged" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.caption" Class="toggle-label" @onclick="() => OnMissingDataChanged(!_showMissingData)">Missing data</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSwitch T="bool" Value="_showTrendLines" ValueChanged="OnShowTrendLinesChanged" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.caption" Class="toggle-label" @onclick="() => OnShowTrendLinesChanged(!_showTrendLines)">Trend line</MudText>
                    </MudStack>
                    </div>
                </div>

                @* RIGHT: warehouse resident selector + date range. A workbook
                   already represents one resident, so no selector is needed. *@
                <div class="control-group resident-group">
                    <span class="control-label">@(_useDataWarehouse ? "Resident and date range" : "Date range")</span>
                    <div class="resident-date-controls">
                    @if (_useDataWarehouse && _viewModel?.AvailableResidents?.Any() == true)
                    {
                        <div class="resident-select">
                            <MudAutocomplete T="string"
                                             Value="_selectedResident"
                                             ValueChanged="OnResidentChanged"
                                             SearchFunc="SearchResidents"
                                             Placeholder="Select ID"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true"
                                             DebounceInterval="150"
                                             MinCharacters="0"
                                             OpenOnFocus="true"
                                             CoerceText="true"
                                             CoerceValue="true"
                                             ResetValueOnEmptyText="true"
                                             SelectValueOnTab="true"
                                             MaxItems="1000"
                                             OpenIcon="@Icons.Material.Filled.ArrowDropDown"
                                             Style="background-color: white;" />
                        </div>
                    }
                    <input id="chart-range-start" type="date"
                           value="@(_startDate?.ToString("yyyy-MM-dd"))"
                           title="From date"
                           @onchange="OnStartDateInputChanged"
                           style="height: 40px; padding: 0 10px; border: 1px solid #c4c4c4; border-radius: 4px;
                                  font-size: 0.875rem; background: white; color: #1a1a1a; cursor: pointer; outline: none;" />
                    <span style="color: #888;">→</span>
                    <input id="chart-range-end" type="date"
                           value="@(_endDate?.ToString("yyyy-MM-dd"))"
                           title="To date"
                           @onchange="OnEndDateInputChanged"
                           style="height: 40px; padding: 0 10px; border: 1px solid #c4c4c4; border-radius: 4px;
                                  font-size: 0.875rem; background: white; color: #1a1a1a; cursor: pointer; outline: none;" />
                    </div>
                </div>
            </div>

            @* --- Chart --- *@
            @if (_viewModel == null)
            {
                <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
            }
            else
            {
                @if (_renderedChartState.ShowMedications)
                {
                    <style>
                        /* Set behavior lines to 0.7 alpha (exclude medication dasharray 2) */
                        path.apexcharts-line:not([stroke-dasharray="2"]):not([style*="stroke-dasharray: 2"]) {
                            stroke-opacity: 0.7 !important;
                        }
                        path.apexcharts-bar-area {
                            fill-opacity: 0.7 !important;
                        }
                    </style>
                }

                <style>
                    /* Preserve full visibility when ApexCharts enlarges a marker on hover. */
                    .apexcharts-series-markers .apexcharts-marker.apexcharts-active,
                    .apexcharts-tooltip-marker {
                        opacity: 1 !important;
                    }
                    .navigator-range-input {
                        position: absolute;
                        inset: 23px 0 24px 0;
                        width: 100%;
                        height: 58px;
                        margin: 0;
                        pointer-events: none;
                        appearance: none;
                        -webkit-appearance: none;
                        background: transparent;
                        z-index: 3;
                    }
                    .navigator-range-input::-webkit-slider-runnable-track {
                        height: 1px;
                        background: transparent;
                    }
                    .navigator-range-input::-webkit-slider-thumb {
                        appearance: none;
                        -webkit-appearance: none;
                        width: 14px;
                        height: 58px;
                        margin-top: -29px;
                        border: 2px solid #5b4ce2;
                        border-radius: 5px;
                        background: #fff;
                        cursor: ew-resize;
                        pointer-events: auto;
                    }
                    .navigator-range-input::-moz-range-track {
                        height: 1px;
                        background: transparent;
                    }
                    .navigator-range-input::-moz-range-thumb {
                        width: 12px;
                        height: 54px;
                        border: 2px solid #5b4ce2;
                        border-radius: 5px;
                        background: #fff;
                        cursor: ew-resize;
                        pointer-events: auto;
                    }
                    .navigator-window-input {
                        position: absolute;
                        inset: 23px 0 31px 0;
                        width: 100%;
                        height: 58px;
                        margin: 0;
                        pointer-events: none;
                        appearance: none;
                        -webkit-appearance: none;
                        background: transparent;
                        z-index: 2;
                        outline: none;
                    }
                    .navigator-window-input::-webkit-slider-runnable-track {
                        height: 1px;
                        background: transparent;
                    }
                    .navigator-window-input::-webkit-slider-thumb {
                        appearance: none;
                        -webkit-appearance: none;
                        width: var(--navigator-window-width);
                        min-width: 18px;
                        height: 58px;
                        margin-top: -29px;
                        border: 0;
                        border-radius: 3px;
                        background: transparent;
                        cursor: grab;
                        pointer-events: auto;
                    }
                    .navigator-window-input:active::-webkit-slider-thumb { cursor: grabbing; }
                    .navigator-window-input::-moz-range-track {
                        height: 1px;
                        background: transparent;
                    }
                    .navigator-window-input::-moz-range-thumb {
                        width: var(--navigator-window-width);
                        min-width: 18px;
                        height: 56px;
                        border: 0;
                        border-radius: 3px;
                        background: transparent;
                        cursor: grab;
                        pointer-events: auto;
                    }
                    .monthly-chart-container .apexcharts-xaxis-texts-g {
                        visibility: hidden;
                    }
                    .monthly-chart-axis-labels {
                        position: absolute;
                        inset: 0;
                        pointer-events: none;
                        z-index: 2;
                        overflow: hidden;
                    }
                    .monthly-chart-axis-label {
                        position: absolute;
                        transform: translateX(-50%);
                        white-space: nowrap;
                        color: #50545a;
                        font: 12px Arial, sans-serif;
                    }
                </style>

                @if (!VisibleTargets.Any())
                {
                    <div style="flex-grow:1; display:flex; align-items:center; justify-content:center; min-height:260px; color:#68757f; text-align:center;">
                        <div>
                            <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="MudBlazor.Size.Large" />
                            <MudText Typo="Typo.subtitle1" Style="margin-top:8px; font-weight:600;">No behaviors selected</MudText>
                            <MudText Typo="Typo.caption">Select one or more behaviors to display the chart.</MudText>
                        </div>
                    </div>
                }
                else
                {
                <div style="flex-grow: 1; display: grid; grid-template-rows: minmax(260px, 1fr) 135px; min-height: 0;">
                    <div id="behavior-main-chart-container"
                         class="@(_selectedPeriod == AggregationPeriod.Month ? "monthly-chart-container" : "")"
                         data-first-month-index="@NavigatorFirstMonthIndex"
                         data-month-count="@(ChartBehaviorCounts.Select(item => item.Date.Date).Distinct().Count())"
                         style="min-height:0; overflow:hidden; position:relative;">
                    <ApexChart @key="ChartKey" TItem="DailyBehaviorCount"
                               @ref="_chart"
                               Options="_options"
                               Height="@("100%")"
                               OnZoomed="OnChartZoomed"
                               OnDataPointEnter="OnChartHover">

                    @if (IsOverlayStackedMode)
                    {
                        var allDates = ChartBehaviorCounts.Select(x => x.Date).Distinct().ToList();

                        @* Mixed stacked bars — per-behavior metric breakdown when data exists *@
                        @foreach (var target in Enumerable.Reverse(VisibleTargets))
                        {
                            var seriesData = ChartBehaviorCounts.Where(x => x.Target == target).ToList();
                            var missingDates = allDates.Except(seriesData.Select(x => x.Date)).ToList();
                            if (missingDates.Any())
                            {
                                seriesData.AddRange(missingDates.Select(d => new DailyBehaviorCount 
                                { 
                                    Date = d, 
                                    Target = target, 
                                    Count = 0, 
                                    Rate = 0,
                                    IntensityBuckets = new double[5],
                                    DurationBuckets = new double[6]
                                }));
                                seriesData = seriesData.OrderBy(x => x.Date).ToList();
                            }

                            var targetColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";

                            var targetMetric = GetTargetOverlayMetric(target, _renderedChartState);

                            @if (targetMetric == OverlayMetric.Intensity)
                            {
                                var iGrad = GenerateGradient(targetColor, IntensityLabels.Count);
                                @for (int i = 0; i < IntensityLabels.Count; i++)
                                {
                                    var lvl = i;
                                    <ApexPointSeries TItem="DailyBehaviorCount"
                                                     Items="seriesData"
                                                     Name="@($"{target} Level {lvl + 1}: {IntensityLabels[lvl]}")"
                                                     Group="@target"
                                                     SeriesType="SeriesType.Bar"
                                                     Color="@iGrad[lvl]"
                                                     XValue="@(e => GetChartXValue(e))"
                                                     YValue="@(e => GetOverlayYValue(e, lvl, true))" />
                                }
                                <ApexPointSeries TItem="DailyBehaviorCount"
                                                 Items="seriesData"
                                                 Name="@($"{target} Intensity unavailable")"
                                                 Group="@target"
                                                 SeriesType="SeriesType.Bar"
                                                 Color="@targetColor"
                                                 XValue="@(e => GetChartXValue(e))"
                                                 YValue="@(e => GetOverlayUnknownYValue(e, true))" />
                            }
                            else if (targetMetric == OverlayMetric.Duration)
                            {
                                var dGrad = GenerateGradient(targetColor, DurationLabels.Count);
                                @for (int i = 0; i < DurationLabels.Count; i++)
                                {
                                    var lvl = i;
                                    <ApexPointSeries TItem="DailyBehaviorCount"
                                                     Items="seriesData"
                                                     Name="@($"{target} Duration {lvl + 1}: {DurationLabels[lvl]}")"
                                                     Group="@target"
                                                     SeriesType="SeriesType.Bar"
                                                     Color="@dGrad[lvl]"
                                                     XValue="@(e => GetChartXValue(e))"
                                                     YValue="@(e => GetOverlayYValue(e, lvl, false))" />
                                }
                                <ApexPointSeries TItem="DailyBehaviorCount"
                                                 Items="seriesData"
                                                 Name="@($"{target} Duration unavailable")"
                                                 Group="@target"
                                                 SeriesType="SeriesType.Bar"
                                                 Color="@targetColor"
                                                 XValue="@(e => GetChartXValue(e))"
                                                 YValue="@(e => GetOverlayUnknownYValue(e, false))" />
                            }
                        }
                    }
                    else
                    {
                        @* Normal rendering — line or bar per target *@
                        var allDates = ChartBehaviorCounts.Select(x => x.Date).Distinct().ToList();
                        @foreach (var target in VisibleTargets)
                        {
                            var seriesData = ChartBehaviorCounts.Where(x => x.Target == target).ToList();

                            var color = _variableSelector?.GetTargetColor(target) ?? "#2196F3";

                            <ApexPointSeries TItem="DailyBehaviorCount"
                                             Items="seriesData"
                                             Name="@target"
                                             SeriesType="@CurrentSeriesType"
                                             Color="@color"
                                             XValue="@(e => GetChartXValue(e))"
                                             YValue="@(e => GetBehaviorYValue(e))" />
                        }

                        var chartMinDate = ChartBehaviorCounts.Any() ? ChartBehaviorCounts.Min(x => x.Date) : (_dateRange?.Start ?? DateTime.Today.AddDays(-30));
                        var chartMaxDate = ChartBehaviorCounts.Any() ? ChartBehaviorCounts.Max(x => x.Date) : (_dateRange?.End ?? DateTime.Today);

                        var behaviorDates = ChartBehaviorCounts
                            .Select(x => x.Date)
                            .Where(d => d >= chartMinDate && d <= chartMaxDate)
                            .Distinct()
                            .OrderBy(d => d)
                            .ToList();

                        @* Intensity overlay as line *@
                        @if (_renderedChartState.ShowIntensity)
                        {
                            @foreach (var target in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Intensity && _targetsWithIntensityData.Contains(t)))
                            {
                                var intensityData = ChartBehaviorCounts
                                    .Where(x => x.Target == target && x.AverageIntensity > 0)
                                    .ToList();
                                var missingDates = behaviorDates.Except(intensityData.Select(x => x.Date)).ToList();
                                if (missingDates.Any())
                                {
                                    var originalData = intensityData.OrderBy(x => x.Date).ToList();
                                    foreach (var d in missingDates)
                                    {
                                        var prev = originalData.LastOrDefault(x => x.Date < d);
                                     intensityData.Add(new DailyBehaviorCount 
                                     { 
                                         Date = d, 
                                         Target = target,
                                         AverageIntensity = 0,
                                         HasData = false 
                                     });
                                    }
                                    intensityData = intensityData.OrderBy(x => x.Date).ToList();
                                }

                                if (intensityData.Any())
                                {
                                    <ApexPointSeries TItem="DailyBehaviorCount"
                                                     Items="intensityData"
                                                     Name="@($"{target} (Severity)")"
                                                     SeriesType="SeriesType.Line"
                                                     Color="#FF9800"
                                                     XValue="@(e => GetChartXValue(e))"
                                                     YValue="@(e => !e.HasData ? 0 : (decimal)Math.Round(e.AverageIntensity, 1))" />
                                }
                            }
                        }

                        @* Duration overlay as line *@
                        @if (_renderedChartState.ShowDuration)
                        {
                            @foreach (var target in VisibleTargets.Where(t => GetTargetOverlayMetric(t, _renderedChartState) == OverlayMetric.Duration && _targetsWithDurationData.Contains(t)))
                            {
                                var durationData = ChartBehaviorCounts
                                    .Where(x => x.Target == target && x.TotalDuration > 0)
                                    .ToList();
                                var missingDates = behaviorDates.Except(durationData.Select(x => x.Date)).ToList();
                                if (missingDates.Any())
                                {
                                    var originalData = durationData.OrderBy(x => x.Date).ToList();
                                    foreach (var d in missingDates)
                                    {
                                        var prev = originalData.LastOrDefault(x => x.Date < d);
                                     durationData.Add(new DailyBehaviorCount 
                                     { 
                                         Date = d, 
                                         Target = target,
                                         TotalDuration = 0,
                                         HasData = false 
                                     });
                                    }
                                    durationData = durationData.OrderBy(x => x.Date).ToList();
                                }

                                if (durationData.Any())
                                {
                                    <ApexPointSeries TItem="DailyBehaviorCount"
                                                     Items="durationData"
                                                     Name="@($"{target} (Duration)")"
                                                     SeriesType="SeriesType.Line"
                                                     Color="#00BCD4"
                                                     XValue="@(e => GetChartXValue(e))"
                                                     YValue="@(e => !e.HasData ? 0 : (decimal)Math.Round(e.TotalDuration, 1))" />
                                }
                            }
                        }

                    }

                    @if (_renderedChartState.ShowTrendLines)
                    {
                        @foreach (var target in VisibleTargets)
                        {
                            var trendData = BuildTrendLineData(target);
                            if (trendData.Count >= 2)
                            {
                                var trendColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";
                                <ApexPointSeries TItem="DailyBehaviorCount"
                                                 Items="trendData"
                                                 Name="@($"{target} (Trend)")"
                                                 SeriesType="SeriesType.Line"
                                                 Color="@trendColor"
                                                 XValue="@(e => GetChartXValue(e))"
                                                 YValue="@(e => (decimal)e.Rate)" />
                            }
                        }
                    }

                    @* Medication dose lines are valid in both normal and stacked
                       modes. Chart.StackOnlyBar keeps them out of the behavior stack. *@
                    @if (ChartComposition.ShowMedicationSeries && validMedsList.Any())
                    {
                        @foreach (var seriesName in validMedsList)
                        {
                            var med = GetMedicationName(seriesName);
                            var medColor = _variableSelector?.GetMedicationColor(med) ?? "#3e2723";
                            var plotData = BuildMedicationPlotData(seriesName);

                            if (plotData.Any())
                            {
                                <ApexPointSeries TItem="DailyBehaviorCount"
                                                 Items="plotData"
                                                 Name="@seriesName"
                                                 SeriesType="SeriesType.Line"
                                                 Color="@medColor"
                                                 XValue="@(e => GetChartXValue(e))"
                                                 YValue="@(e => !e.HasData ? null : (decimal)Math.Log10(e.Rate))" />
                            }
                        }
                    }
                    </ApexChart>
                    @if (_selectedPeriod == AggregationPeriod.Month)
                    {
                        <div id="monthly-chart-axis-labels" class="monthly-chart-axis-labels" aria-hidden="true"></div>
                    }
                    </div>

                    @if (NavigatorBehaviorCounts.Any())
                    {
                        <div style="height:135px; min-height:0; padding:0 8px 2px; border-top:1px solid #eceff1;">
                            <MudText Typo="Typo.caption" Style="display:block; color:#68757f; font-weight:600; margin:2px 0 -5px 4px;">
                                Full history — drag the highlighted window
                            </MudText>
                            <div style="height:112px; position:relative;">
                                <ApexChart @key="NavigatorChartKey"
                                           TItem="DailyBehaviorCount"
                                           Options="_navigatorOptions"
                                           Height="@("112px")">
                                    @foreach (var target in NavigatorVisibleTargets)
                                    {
                                        var navigatorData = NavigatorBehaviorCounts
                                            .Where(item => item.Target == target)
                                            .OrderBy(item => item.Date)
                                            .ToList();
                                        var navigatorColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";
                                        <ApexPointSeries TItem="DailyBehaviorCount"
                                                         Items="navigatorData"
                                                         Name="@target"
                                                         SeriesType="SeriesType.Line"
                                                         Color="@navigatorColor"
                                                         XValue="@(item => (object)item.Date)"
                                                         YValue="@(item => _yAxisMetric == YAxisMetric.Rate ? (decimal)item.Rate : item.Count)" />
                                    }
                                </ApexChart>
                                <div class="navigator-selection-window" style="position:absolute; top:23px; bottom:31px; left:@NavigatorSelectionLeftPercent%; width:@NavigatorSelectionWidthPercent%; background:rgba(91,76,226,.14); border:1px solid rgba(91,76,226,.65); border-radius:3px; pointer-events:none; z-index:1;"></div>
                                <input @key="NavigatorControlKey" id="navigator-window-control" class="navigator-window-input" type="range"
                                       min="@(_selectedPeriod == AggregationPeriod.Month ? 0 : NavigatorWindowMinDay)"
                                       max="@(_selectedPeriod == AggregationPeriod.Month ? NavigatorWindowMaxMonthIndex : NavigatorWindowMaxDay)"
                                       value="@(_selectedPeriod == AggregationPeriod.Month ? NavigatorSelectedStartMonthIndex : NavigatorSelectedStartDay)"
                                       data-span-days="@NavigatorSelectedSpanDays"
                                       data-full-min-day="@NavigatorMinDay"
                                       data-full-max-day="@NavigatorMaxDay"
                                       data-period="@_selectedPeriod"
                                       data-period-count="@NavigatorSelectedPeriodCount"
                                       data-first-month-index="@NavigatorFirstMonthIndex"
                                       data-month-count="@(NavigatorBehaviorCounts.Select(item => item.Date.Date).Distinct().Count())"
                                       aria-label="Move selected date window" title="Drag to scroll through the full history"
                                       style="--navigator-window-width:@NavigatorSelectionWidthPercent%;"
                                       @onchange="OnNavigatorWindowChanged" />
                            </div>
                        </div>
                    }
                </div>

                @* Custom split legend for normal (line/bar) mode *@
                @if (!IsOverlayStackedMode)
                {
                    <MudStack Spacing="1" Class="mt-2 px-2">
                        @* Behaviors row *@
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="flex-wrap: wrap;">
                            @foreach (var target in VisibleTargets)
                            {
                                var tc = _variableSelector?.GetTargetColor(target) ?? "#2196F3";
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <div style="width:12px; height:12px; border-radius:2px; background:@tc;"></div>
                                    <MudText Typo="Typo.caption" Style="font-weight:600;">@target</MudText>
                                </MudStack>
                            }
                        </MudStack>
                        @* Medications row (only shown when meds overlay is active) *@
                        @if (_renderedChartState.ShowMedications && validMedsList.Any())
                        {
                            <MudDivider Class="my-1" />
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="flex-wrap: wrap;">
                                @foreach (var medicationSeries in validMedsList)
                                {
                                    var medicationName = GetMedicationName(medicationSeries);
                                    var medicationColor = _variableSelector?.GetMedicationColor(medicationName) ?? "#3e2723";
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <div style="width:22px; height:3px; background:@medicationColor; border-radius:2px;"></div>
                                        <MudText Typo="Typo.caption" Style="font-weight:500;">@medicationSeries</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }
                    </MudStack>
                }

                @* Custom legend for stacked mode — clean, non-crowded *@
                @if (IsOverlayStackedMode)
                {
                    <MudStack Spacing="2" Class="mt-3 px-2">
                        @* Behavior labels with gradient swatch *@
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="flex-wrap: wrap;">
                            @foreach (var target in VisibleTargets)
                            {
                                var targetColor = _variableSelector?.GetTargetColor(target) ?? "#2196F3";
                                var targetMetric = GetTargetOverlayMetric(target, _renderedChartState);
                                var hasIntensity = targetMetric == OverlayMetric.Intensity && _targetsWithIntensityData.Contains(target);
                                var hasDuration = targetMetric == OverlayMetric.Duration && _targetsWithDurationData.Contains(target);
                                var metricLabel = hasIntensity
                                    ? "severity"
                                    : (hasDuration
                                        ? "duration"
                                        : (targetMetric == OverlayMetric.Intensity ? "intensity unavailable" : "duration unavailable"));
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (hasIntensity || hasDuration)
                                    {
                                        @* Gradient swatch showing light→dark of behavior color *@
                                        var steps = 5;
                                        var grad = GenerateGradient(targetColor, steps);
                                        <div style="display:flex; border-radius:2px; overflow:hidden; opacity: 0.8;">
                                            @foreach (var c in grad)
                                            {
                                                <div style="width:5px; height:12px; background:@c;"></div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width:12px; height:12px; border-radius:2px; background:@targetColor; opacity: 0.8;"></div>
                                    }
                                    <MudText Typo="Typo.caption" Style="font-weight:600; cursor: pointer; user-select: none;"
                                             @onclick="@(() => ToggleTargetFromLegend(target))"
                                             @ondblclick="@(() => IsolateTargetFromLegend(target))">
                                        @target
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(metricLabel))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#888; font-style:italic;">(@metricLabel)</MudText>
                                    }
                                </MudStack>
                            }
                        </MudStack>

                        @* Scale key — light = low, dark = high *@
                        <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center">
                            @if (_renderedChartState.ShowIntensity && _targetsWithIntensityData.Any())
                            {
                                <MudText Typo="Typo.caption" Style="color:#999; font-size:0.65rem;">Light = @IntensityLabels[0]</MudText>
                                <MudText Typo="Typo.caption" Style="color:#bbb; font-size:0.6rem;">→</MudText>
                                <MudText Typo="Typo.caption" Style="color:#999; font-size:0.65rem;">Dark = @IntensityLabels[^1]</MudText>
                            }
                            @if (_renderedChartState.ShowDuration && _targetsWithDurationData.Any())
                            {
                                @if (_renderedChartState.ShowIntensity && _targetsWithIntensityData.Any())
                                {
                                    <MudDivider Vertical="true" FlexItem="true" Style="height:12px; margin:0 8px;" />
                                }
                                <MudText Typo="Typo.caption" Style="color:#999; font-size:0.65rem;">Light = @DurationLabels[0]</MudText>
                                <MudText Typo="Typo.caption" Style="color:#bbb; font-size:0.6rem;">→</MudText>
                                <MudText Typo="Typo.caption" Style="color:#999; font-size:0.65rem;">Dark = @DurationLabels[^1]</MudText>
                            }
                        </MudStack>

                        @if (_renderedChartState.ShowMedications && validMedsList.Any())
                        {
                            <MudDivider Class="my-1" />
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="flex-wrap: wrap;">
                                @foreach (var medicationSeries in validMedsList)
                                {
                                    var medicationName = GetMedicationName(medicationSeries);
                                    var medicationColor = _variableSelector?.GetMedicationColor(medicationName) ?? "#3e2723";
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <div style="width:22px; height:3px; background:@medicationColor; border-radius:2px;"></div>
                                        <MudText Typo="Typo.caption" Style="font-weight:500;">@medicationSeries</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }
                    </MudStack>
                }
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // --- State ---
    private DashboardViewModel? _viewModel;
    private DashboardViewModel? _fullHistoryViewModel;
    private DashboardViewModel? _navigatorViewModel;
    private ApexChartOptions<DailyBehaviorCount>? _options;
    private ApexChartOptions<DailyBehaviorCount>? _navigatorOptions;
    private ApexChart<DailyBehaviorCount>? _chart;
    private DotNetObjectReference<Home>? _dotNetReference;
    private VariableSelector? _variableSelector;
    private bool _filtersOpen = true;
    private long _chartRevision;
    private long _navigatorRevision;
    private CancellationTokenSource? _chartUpdateDebounce;
    private CancellationTokenSource? _navigatorUpdateDebounce;
    private CancellationTokenSource? _navigatorLiveUpdateDebounce;

    // --- Data Source State ---
    private bool _useDataWarehouse = false;
    private PsychDashboard.Services.ParsedWorkbookResult? _parsedWorkbook;
    private readonly HashSet<string> _loadedWorkbookSignatures = new(StringComparer.Ordinal);
    private string _uploadMessage = "";
    private MudBlazor.Color _uploadMessageColor = MudBlazor.Color.Default;

    private AggregationPeriod _selectedPeriod = AggregationPeriod.Month;
    private YAxisMetric _yAxisMetric = YAxisMetric.Rate;
    private ChartDisplayType _chartType = ChartDisplayType.Bar;
    private DateRange? _dateRange;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _chartTitle => string.IsNullOrEmpty(_selectedResident) ? "Behavior History" : _selectedResident;

    // Shift filtering
    private IReadOnlyCollection<string> _selectedShifts = new HashSet<string> { "7-3", "3-11", "11-7" };
    private string? _selectedResident;
    private DateTime? _preZoomStartDate;
    private DateTime? _preZoomEndDate;
    private bool _isApplyingChartZoom;
    private bool _isApplyingNavigatorSelection;

    // Overlay toggles
    private bool _showIntensity = false;
    private bool _showDuration = false;
    private bool _showMissingData = false;
    private bool _showMedications = false;
    private bool _showTrendLines = false;
    private OverlayMetric _overlayPriority = OverlayMetric.None;

    // Controls update immediately, while the chart consumes a debounced,
    // internally consistent snapshot. This prevents a burst of clicks from
    // mounting several JavaScript chart instances at once.
    private ChartViewState _renderedChartState = new(
        ChartDisplayType.Bar,
        ShowIntensity: false,
        ShowDuration: false,
        ShowMedications: false,
        ShowTrendLines: false);

    // Intervention dates
    private List<InterventionDate> _interventions = new();

    // --- Stacked bar labels ---
    private static readonly string[] DefaultIntensityLabels = { "Minimal (1)", "Mild (2)", "Moderate (3)", "Severe (4)", "Extreme (5)" };
    private static readonly string[] DefaultDurationLabels = { "<5 min", "6-10 min", "11-20 min", "21-30 min", "31-60 min", "60+ min" };
    private IReadOnlyList<string> IntensityLabels => _parsedWorkbook?.IntensityLabels.Count > 0
        ? _parsedWorkbook.IntensityLabels.Take(5).ToList()
        : DefaultIntensityLabels;
    private IReadOnlyList<string> DurationLabels => _parsedWorkbook?.DurationLabels.Count > 0
        ? _parsedWorkbook.DurationLabels.Take(6).ToList()
        : DefaultDurationLabels;

    // --- Data-driven metric availability (computed dynamically based on visible date range) ---
    private HashSet<string> _targetsWithIntensityData => ChartBehaviorCounts
        .Where(x => x.IntensityBuckets != null && x.IntensityBuckets.Any(b => b > 0))
        .Select(x => x.Target).ToHashSet();

    private HashSet<string> _targetsWithDurationData => ChartBehaviorCounts
        .Where(x => x.DurationBuckets != null && x.DurationBuckets.Any(b => b > 0))
        .Select(x => x.Target).ToHashSet();

    // --- Computed Properties ---
    private string ChartKey => _chartRevision.ToString();
    private string NavigatorChartKey => $"navigator-{_navigatorRevision}";
    private string NavigatorControlKey => $"navigator-control-{_navigatorRevision}";
    private List<DailyBehaviorCount> NavigatorBehaviorCounts =>
        _navigatorViewModel?.DailyBehaviorCounts ?? new List<DailyBehaviorCount>();
    // Keep the complete aggregation for the selected grouping mounted in the
    // main chart. The overview uses a separate, always-monthly behavior series.
    private List<DailyBehaviorCount> ChartBehaviorCounts =>
        _selectedPeriod == AggregationPeriod.Average
            ? FilteredBehaviorCounts
            : _fullHistoryViewModel?.DailyBehaviorCounts ?? new List<DailyBehaviorCount>();
    private List<string> NavigatorVisibleTargets => VisibleTargets
        .Where(target => NavigatorBehaviorCounts.Any(item => item.Target == target))
        .ToList();
    private static readonly DateTime NavigatorEpoch = new(1970, 1, 1);
    private int NavigatorMinDay => NavigatorBehaviorCounts.Any()
        ? (NavigatorBehaviorCounts.Min(item => item.Date).Date - NavigatorEpoch).Days
        : 0;
    private int NavigatorMaxDay => NavigatorBehaviorCounts.Any()
        ? (NavigatorBehaviorCounts
            .Select(item => item.PeriodEnd >= item.Date ? item.PeriodEnd.Date : item.Date.Date)
            .Max() - NavigatorEpoch).Days
        : 1;
    private int NavigatorSelectedStartDay => Math.Clamp(
        ((_startDate ?? _dateRange?.Start ?? NavigatorEpoch.AddDays(NavigatorMinDay)).Date - NavigatorEpoch).Days,
        NavigatorMinDay, NavigatorMaxDay);
    private int NavigatorSelectedEndDay => Math.Clamp(
        ((_endDate ?? _dateRange?.End ?? NavigatorEpoch.AddDays(NavigatorMaxDay)).Date - NavigatorEpoch).Days,
        NavigatorMinDay, NavigatorMaxDay);
    private int NavigatorSelectedSpanDays => Math.Max(0, NavigatorSelectedEndDay - NavigatorSelectedStartDay);
    private int NavigatorSelectedPeriodCount => _selectedPeriod switch
    {
        AggregationPeriod.Month => Math.Max(1,
            (((_endDate ?? _dateRange?.End ?? NavigatorEpoch.AddDays(NavigatorMaxDay)).Year -
              (_startDate ?? _dateRange?.Start ?? NavigatorEpoch.AddDays(NavigatorMinDay)).Year) * 12) +
             (_endDate ?? _dateRange?.End ?? NavigatorEpoch.AddDays(NavigatorMaxDay)).Month -
             (_startDate ?? _dateRange?.Start ?? NavigatorEpoch.AddDays(NavigatorMinDay)).Month + 1),
        _ => 0
    };
    private int NavigatorFirstMonthIndex => NavigatorBehaviorCounts.Any()
        ? (NavigatorBehaviorCounts.Min(item => item.Date).Year * 12) + NavigatorBehaviorCounts.Min(item => item.Date).Month - 1
        : 0;
    private int NavigatorMonthCount => NavigatorBehaviorCounts
        .Select(item => item.Date.Date).Distinct().Count();
    private int NavigatorWindowMaxMonthIndex => Math.Max(0, NavigatorMonthCount - NavigatorSelectedPeriodCount);
    private int NavigatorSelectedStartMonthIndex
    {
        get
        {
            var start = _startDate ?? _dateRange?.Start ?? NavigatorEpoch.AddDays(NavigatorMinDay);
            return Math.Clamp(start.Year * 12 + start.Month - 1 - NavigatorFirstMonthIndex,
                0, NavigatorWindowMaxMonthIndex);
        }
    }

    private object GetChartXValue(DailyBehaviorCount item) => _selectedPeriod switch
    {
        AggregationPeriod.Average => item.Target,
        AggregationPeriod.Month => (item.Date.Year * 12 + item.Date.Month - 1) - NavigatorFirstMonthIndex,
        _ => item.Date
    };
    private long GetAnnotationXValue(DateTime date) => _selectedPeriod == AggregationPeriod.Month
        ? (date.Year * 12 + date.Month - 1) - NavigatorFirstMonthIndex
        : new DateTimeOffset(date).ToUnixTimeMilliseconds();
    private int NavigatorWindowMinDay => NavigatorMinDay;
    private int NavigatorWindowMaxDay => Math.Max(NavigatorMinDay, NavigatorMaxDay - NavigatorSelectedSpanDays);
    private double NavigatorSelectionLeftPercent => NavigatorMaxDay == NavigatorMinDay
        ? 0
        : 100d * (NavigatorSelectedStartDay - NavigatorMinDay) / (NavigatorMaxDay - NavigatorMinDay);
    private double NavigatorSelectionWidthPercent => NavigatorMaxDay == NavigatorMinDay
        ? 100
        : 100d * (NavigatorSelectedEndDay - NavigatorSelectedStartDay) / (NavigatorMaxDay - NavigatorMinDay);
    private ChartCompositionState ChartComposition => ChartCompositionState.Resolve(
        _renderedChartState.ChartType,
        _renderedChartState.ShowIntensity,
        _targetsWithIntensityData.Any(),
        _renderedChartState.ShowDuration,
        _targetsWithDurationData.Any(),
        _renderedChartState.ShowMedications,
        IntensityLabels.Count,
        DurationLabels.Count);
    private bool IsOverlayStackedMode => ChartComposition.IsStacked;

    private OverlayMetric GetTargetOverlayMetric(string target, ChartViewState state)
    {
        var intensityAvailable = state.ShowIntensity && _targetsWithIntensityData.Contains(target);
        var durationAvailable = state.ShowDuration && _targetsWithDurationData.Contains(target);

        if (intensityAvailable && !durationAvailable) return OverlayMetric.Intensity;
        if (durationAvailable && !intensityAvailable) return OverlayMetric.Duration;
        if (intensityAvailable && durationAvailable)
            return _overlayPriority == OverlayMetric.Duration ? OverlayMetric.Duration : OverlayMetric.Intensity;

        // Preserve the existing "unavailable" bar for targets without either
        // selected metric, using the user's first-selected overlay.
        if (state.ShowIntensity && state.ShowDuration)
            return _overlayPriority == OverlayMetric.Duration ? OverlayMetric.Duration : OverlayMetric.Intensity;
        if (state.ShowIntensity) return OverlayMetric.Intensity;
        if (state.ShowDuration) return OverlayMetric.Duration;
        return OverlayMetric.None;
    }

    private int GetTargetOverlaySeriesCount(string target) => GetTargetOverlayMetric(target, _renderedChartState) switch
    {
        OverlayMetric.Intensity => IntensityLabels.Count + 1,
        OverlayMetric.Duration => DurationLabels.Count + 1,
        _ => 1
    };

    private SeriesType CurrentSeriesType => _renderedChartState.ChartType switch
    {
        ChartDisplayType.Line => SeriesType.Line,
        ChartDisplayType.Bar => SeriesType.Bar,
        _ => SeriesType.Line
    };

    private List<string> VisibleTargets
    {
        get
        {
            if (_viewModel == null) return new();
            return _viewModel.AvailableTargets
                .Where(t => _variableSelector?.IsTargetVisible(t) ?? true)
                .OrderByDescending(t => _viewModel.DailyBehaviorCounts.Where(x => x.Target == t).Sum(x => x.Count))
                .ToList();
        }
    }

    private List<string> SortedAvailableTargets
    {
        get
        {
            if (_viewModel == null || _viewModel.AvailableTargets == null) return new();
            return _viewModel.AvailableTargets
                .OrderByDescending(t => FilteredBehaviorCounts.Where(x => x.Target == t && x.HasData).Sum(x => x.Count))
                .ToList();
        }
    }

    private List<DailyBehaviorCount> FilteredBehaviorCounts
    {
        get
        {
            if (_viewModel == null) return new();
            var data = _viewModel.DailyBehaviorCounts.AsEnumerable();

            // Date range filter
            if (_dateRange != null && _dateRange.Start != null && _dateRange.End != null)
            {
                var start = GetAggregatePeriodStart(_dateRange.Start.Value.Date);
                var end = _dateRange.End.Value.Date.AddDays(1).AddTicks(-1);
                data = data.Where(x => x.Date >= start && x.Date <= end);
            }

            return data.ToList();
        }
    }

    private DateTime GetAggregatePeriodStart(DateTime date) => _selectedPeriod switch
    {
        AggregationPeriod.Month => new DateTime(date.Year, date.Month, 1),
        // Weekly periods are anchored to the first available date rather than
        // calendar weeks, so the aggregated point is already the period start.
        AggregationPeriod.Week => date.Date,
        _ => date.Date
    };

    // --- Lifecycle ---
    protected override async Task OnInitializedAsync()
    {
        await LoadDefaultDateRangeAsync();
        BuildChartOptions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            BuildChartOptions();
            StateHasChanged();
        }

        try
        {
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chartNavigator.initialize", _dotNetReference);
        }
        catch (JSDisconnectedException)
        {
            // The browser navigated away while the navigator was initializing.
        }
    }

