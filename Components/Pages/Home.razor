    private Task OnShowIntensityChanged(bool val) =>
        ApplyChartStateAsync(() =>
        {
            if (val && !_showIntensity && !_showDuration)
                _overlayPriority = OverlayMetric.Intensity;
            _showIntensity = val;
            if (!val && _overlayPriority == OverlayMetric.Intensity)
                _overlayPriority = _showDuration ? OverlayMetric.Duration : OverlayMetric.None;
        });

    private Task OnShowDurationChanged(bool val) =>
        ApplyChartStateAsync(() =>
        {
            if (val && !_showDuration && !_showIntensity)
                _overlayPriority = OverlayMetric.Duration;
            _showDuration = val;
            if (!val && _overlayPriority == OverlayMetric.Duration)
                _overlayPriority = _showIntensity ? OverlayMetric.Intensity : OverlayMetric.None;
        });

    private async Task ApplyChartStateAsync(Action updateState)
    {
        updateState();

        var debounce = new CancellationTokenSource();
        var previousDebounce = Interlocked.Exchange(ref _chartUpdateDebounce, debounce);
        previousDebounce?.Cancel();
        previousDebounce?.Dispose();

        try
        {
            await Task.Delay(150, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(_chartUpdateDebounce, debounce)) return;

        _renderedChartState = new ChartViewState(
            _chartType,
            _showIntensity,
            _showDuration,
            _showMedications,
            _showTrendLines);
        BuildChartOptions();
        _chartRevision++;

        Interlocked.CompareExchange(ref _chartUpdateDebounce, null, debounce);
        debounce.Dispose();
        await InvokeAsync(StateHasChanged);
    }

    private readonly record struct ChartViewState(
        ChartDisplayType ChartType,
        bool ShowIntensity,
        bool ShowDuration,
        bool ShowMedications,
        bool ShowTrendLines);

    private enum OverlayMetric
    {
        None,
        Intensity,
        Duration
    }

    public void Dispose()
    {
        var debounce = Interlocked.Exchange(ref _chartUpdateDebounce, null);
        debounce?.Cancel();
        debounce?.Dispose();
        var navigatorDebounce = Interlocked.Exchange(ref _navigatorUpdateDebounce, null);
        navigatorDebounce?.Cancel();
        navigatorDebounce?.Dispose();
        CancelNavigatorLiveUpdate();
        _dotNetReference?.Dispose();
    }

    // --- Data Loading ---
    private async Task LoadDataAsync(bool refreshNavigator = true)
    {
        var shifts = _selectedShifts != null ? new HashSet<string>(_selectedShifts) : null;
        DateTime? filterStart = _startDate ?? _dateRange?.Start;
        DateTime? filterEnd = _endDate ?? _dateRange?.End;
        var hiddenSubcategories = _variableSelector?.GetHiddenSubcategories();

        if (!_useDataWarehouse)
        {
            if (_parsedWorkbook == null)
            {
                _viewModel = new DashboardViewModel();
                _fullHistoryViewModel = new DashboardViewModel();
                _navigatorViewModel = new DashboardViewModel();
                _selectedResident = null;
                _startDate = null;
                _endDate = null;
                _dateRange = null;
                return;
            }

            _viewModel = await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                _selectedPeriod, shifts, filterStart, filterEnd, hiddenSubcategories);
            if (refreshNavigator)
            {
                _fullHistoryViewModel = await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                    _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                    _selectedPeriod,
                    shifts, null, null, hiddenSubcategories);
                _navigatorViewModel = _selectedPeriod == AggregationPeriod.Month
                    ? _fullHistoryViewModel
                    : await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                        _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                        AggregationPeriod.Month, shifts, null, null, hiddenSubcategories);
            }
        }
        else
        {
            _viewModel = await PatientHistoryService.GetPatientHistoryAsync(_selectedPeriod, shifts, _selectedResident, filterStart, filterEnd, hiddenSubcategories);
            if (refreshNavigator)
            {
                _fullHistoryViewModel = await PatientHistoryService.GetPatientHistoryAsync(
                    _selectedPeriod,
                    shifts, _selectedResident, null, null, hiddenSubcategories);
                _navigatorViewModel = _selectedPeriod == AggregationPeriod.Month
                    ? _fullHistoryViewModel
                    : await PatientHistoryService.GetPatientHistoryAsync(
                        AggregationPeriod.Month, shifts, _selectedResident, null, null, hiddenSubcategories);
            }
        }

        if (_viewModel != null)
        {
            if (string.IsNullOrEmpty(_selectedResident) && _viewModel.AvailableResidents.Any())
            {
                _selectedResident = _viewModel.AvailableResidents.First();
                if (!_useDataWarehouse)
                {
                    _viewModel = await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                        _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                        _selectedPeriod, shifts, filterStart, filterEnd, hiddenSubcategories);
                    if (refreshNavigator)
                    {
                        _fullHistoryViewModel = await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                            _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                            _selectedPeriod,
                            shifts, null, null, hiddenSubcategories);
                        _navigatorViewModel = _selectedPeriod == AggregationPeriod.Month
                            ? _fullHistoryViewModel
                            : await PatientHistoryService.GetPatientHistoryFromRecordsAsync(
                                _parsedWorkbook.Behaviors, _parsedWorkbook.Medications,
                                AggregationPeriod.Month, shifts, null, null, hiddenSubcategories);
                    }
                }
                else
                {
                    _viewModel = await PatientHistoryService.GetPatientHistoryAsync(_selectedPeriod, shifts, _selectedResident, filterStart, filterEnd, hiddenSubcategories);
                    if (refreshNavigator)
                    {
                        _fullHistoryViewModel = await PatientHistoryService.GetPatientHistoryAsync(
                            _selectedPeriod,
                            shifts, _selectedResident, null, null, hiddenSubcategories);
                        _navigatorViewModel = _selectedPeriod == AggregationPeriod.Month
                            ? _fullHistoryViewModel
                            : await PatientHistoryService.GetPatientHistoryAsync(
                                AggregationPeriod.Month, shifts, _selectedResident, null, null, hiddenSubcategories);
                    }
                }
            }
        }
        if (refreshNavigator)
            _navigatorRevision++;
    }

