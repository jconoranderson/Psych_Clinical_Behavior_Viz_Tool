    private async Task OnNavigatorWindowChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var requestedStartDay)) return;

        CancelNavigatorLiveUpdate();
        if (_selectedPeriod == AggregationPeriod.Month)
        {
            var firstMonth = NavigatorBehaviorCounts.Min(item => item.Date);
            var startDate = new DateTime(firstMonth.Year, firstMonth.Month, 1)
                .AddMonths(Math.Clamp(requestedStartDay, 0, NavigatorWindowMaxMonthIndex));
            var endDate = startDate.AddMonths(NavigatorSelectedPeriodCount).AddDays(-1);
            var fullEnd = NavigatorEpoch.AddDays(NavigatorMaxDay);
            if (endDate > fullEnd)
            {
                endDate = fullEnd;
                startDate = new DateTime(endDate.Year, endDate.Month, 1)
                    .AddMonths(-(NavigatorSelectedPeriodCount - 1));
            }

            await ApplyNavigatorRangeAsync(
                (startDate - NavigatorEpoch).Days,
                (endDate - NavigatorEpoch).Days);
            return;
        }

        var spanDays = NavigatorSelectedSpanDays;
        var startDay = Math.Clamp(requestedStartDay, NavigatorWindowMinDay, NavigatorWindowMaxDay);
        var endDay = Math.Min(NavigatorMaxDay, startDay + spanDays);
        await ApplyNavigatorRangeAsync(startDay, endDay);
    }

    private async Task OnNavigatorWindowInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var requestedStartDay)) return;

        var spanDays = NavigatorSelectedSpanDays;
        var startDay = Math.Clamp(requestedStartDay, NavigatorWindowMinDay, NavigatorWindowMaxDay);
        var endDay = Math.Min(NavigatorMaxDay, startDay + spanDays);

        // Move the controls and the existing Apex viewport immediately. The
        // complete series remains mounted, so bars translate with the pointer.
        // Summaries and range-specific calculations are finalized on change.
        _startDate = NavigatorEpoch.AddDays(startDay);
        _endDate = NavigatorEpoch.AddDays(endDay);
        _dateRange = new DateRange(_startDate, _endDate);
        await InvokeAsync(StateHasChanged);

        if (_chart != null && _selectedPeriod != AggregationPeriod.Average)
        {
            _isApplyingNavigatorSelection = true;
            try
            {
                var viewportStart = new DateTimeOffset(
                    DateTime.SpecifyKind(_startDate.Value.Date, DateTimeKind.Utc)).ToUnixTimeMilliseconds();
                var viewportEnd = new DateTimeOffset(
                    DateTime.SpecifyKind(_endDate.Value.Date.AddDays(1).AddMilliseconds(-1), DateTimeKind.Utc)).ToUnixTimeMilliseconds();
                await _chart.ZoomXAsync(viewportStart, viewportEnd);
            }
            finally
            {
                _isApplyingNavigatorSelection = false;
            }
        }
    }

    private void CancelNavigatorLiveUpdate()
    {
        var pending = Interlocked.Exchange(ref _navigatorLiveUpdateDebounce, null);
        pending?.Cancel();
        pending?.Dispose();
    }

    private async Task ApplyNavigatorRangeAsync(int startDay, int endDay)
    {
        ClearChartZoomBaseline();
        _startDate = NavigatorEpoch.AddDays(startDay);
        _endDate = NavigatorEpoch.AddDays(endDay);
        _dateRange = new DateRange(_startDate, _endDate);

        var navigatorOptions = _navigatorOptions;
        await LoadDataAsync(refreshNavigator: false);
        _navigatorOptions = navigatorOptions;

        // The full-history chart series and the client-side viewport are
        // already correct at the end of a navigator drag. Rebuilding Apex here
        // causes boundary bars to disappear/reappear and is especially jarring
        // for stacked intensity/duration series. Only a visible trend line is
        // range-derived and therefore requires a chart refresh on release.
        if (_renderedChartState.ShowTrendLines)
            BuildChartOptions();

        await InvokeAsync(StateHasChanged);
        if (_renderedChartState.ShowTrendLines)
            await RenderChart();
    }

    private async Task OnChartZoomed(ZoomedData<DailyBehaviorCount> zoom)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("chartNavigator.shouldSuppressChartZoomEvent"))
                return;
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (_selectedPeriod == AggregationPeriod.Average ||
            _isApplyingChartZoom ||
            _isApplyingNavigatorSelection)
            return;

        _isApplyingChartZoom = true;
        try
        {
            if (!zoom.IsZoomed)
            {
                var fullRange = GetFullAvailableDateRange();
                if (!fullRange.Start.HasValue || !fullRange.End.HasValue)
                    return;

                // ApexCharts' Reset Zoom/Home control always restores the
                // complete source range. Do not depend on a pre-zoom snapshot:
                // navigator-driven viewport changes intentionally bypass that
                // state, and a later narrow chart zoom must still be recoverable.
                _startDate = fullRange.Start;
                _endDate = fullRange.End;
                ClearChartZoomBaseline();
            }
            else
            {
                if (!zoom.XAxis.Min.HasValue || !zoom.XAxis.Max.HasValue)
                    return;

                if (!_preZoomStartDate.HasValue || !_preZoomEndDate.HasValue)
                {
                    _preZoomStartDate = _startDate;
                    _preZoomEndDate = _endDate;
                }

                DateTime zoomStart;
                DateTime zoomEnd;
                if (_selectedPeriod == AggregationPeriod.Month)
                {
                    var months = ChartBehaviorCounts.Select(item => item.Date.Date)
                        .Distinct().OrderBy(date => date).ToList();
                    if (months.Count == 0) return;
                    var startIndex = Math.Clamp(
                        Convert.ToInt32(Math.Ceiling(zoom.XAxis.Min.Value)), 0, months.Count - 1);
                    var endIndex = Math.Clamp(
                        Convert.ToInt32(Math.Floor(zoom.XAxis.Max.Value)), startIndex, months.Count - 1);
                    zoomStart = new DateTime(months[startIndex].Year, months[startIndex].Month, 1);
                    zoomEnd = new DateTime(months[endIndex].Year, months[endIndex].Month, 1)
                        .AddMonths(1).AddDays(-1);
                }
                else
                {
                    zoomStart = DateTimeOffset
                        .FromUnixTimeMilliseconds(Convert.ToInt64(Math.Floor(zoom.XAxis.Min.Value)))
                        .UtcDateTime.Date;
                    zoomEnd = DateTimeOffset
                        .FromUnixTimeMilliseconds(Convert.ToInt64(Math.Ceiling(zoom.XAxis.Max.Value)))
                        .UtcDateTime.Date;
                }

                // Once a zoom has been applied, the chart is rebuilt from the
                // narrowed dataset. ApexCharts therefore reports Reset Zoom as
                // the complete bounds of that narrowed chart and still marks
                // the event as zoomed. Detect that payload explicitly and
                // restore the complete source range.
                var renderedDates = FilteredBehaviorCounts
                    .Select(item => item.Date.Date)
                    .Distinct()
                    .ToList();
                var resetToRenderedBounds = _preZoomStartDate.HasValue
                    && _preZoomEndDate.HasValue
                    && renderedDates.Count > 0
                    && zoomStart <= renderedDates.Min()
                    && zoomEnd >= renderedDates.Max();

                if (resetToRenderedBounds)
                {
                    var fullRange = GetFullAvailableDateRange();
                    if (!fullRange.Start.HasValue || !fullRange.End.HasValue)
                        return;

                    _startDate = fullRange.Start;
                    _endDate = fullRange.End;
                    ClearChartZoomBaseline();
                }
                else
                {
                    if (_preZoomStartDate.HasValue && zoomStart < _preZoomStartDate.Value.Date)
                        zoomStart = _preZoomStartDate.Value.Date;
                    if (_preZoomEndDate.HasValue && zoomEnd > _preZoomEndDate.Value.Date)
                        zoomEnd = _preZoomEndDate.Value.Date;
                    if (zoomEnd < zoomStart)
                        return;

                    _startDate = zoomStart;
                    _endDate = zoomEnd;
                }
            }

            _dateRange = new DateRange(_startDate, _endDate);
            await LoadDataAsync();
            BuildChartOptions();
            await InvokeAsync(StateHasChanged);
            await RenderChart();
        }
        finally
        {
            _isApplyingChartZoom = false;
        }
    }

    [JSInvokable]
    public async Task ResetChartToFullRange()
    {
        var fullRange = GetFullAvailableDateRange();
        if (!fullRange.Start.HasValue || !fullRange.End.HasValue)
            return;

        _isApplyingChartZoom = true;
        try
        {
            _startDate = fullRange.Start.Value.Date;
            _endDate = fullRange.End.Value.Date;
            _dateRange = new DateRange(_startDate, _endDate);
            ClearChartZoomBaseline();

            var navigatorOptions = _navigatorOptions;
            await LoadDataAsync(refreshNavigator: false);
            BuildChartOptions();
            _navigatorOptions = navigatorOptions;
            await InvokeAsync(StateHasChanged);
            await RenderChart();
        }
        finally
        {
            _isApplyingChartZoom = false;
        }
    }

    private Task OnNavigatorChanged(SelectionData<DailyBehaviorCount> selection)
    {
        if (_isApplyingNavigatorSelection ||
            _isApplyingChartZoom ||
            selection?.XAxis == null ||
            !selection.XAxis.Min.HasValue ||
            !selection.XAxis.Max.HasValue)
            return Task.CompletedTask;

        var debounce = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _navigatorUpdateDebounce, debounce);
        previous?.Cancel();
        previous?.Dispose();
        _ = ApplyNavigatorSelectionAfterDragAsync(
            selection.XAxis.Min.Value,
            selection.XAxis.Max.Value,
            debounce);
        return Task.CompletedTask;
    }

    private async Task ApplyNavigatorSelectionAfterDragAsync(
        decimal selectedMin,
        decimal selectedMax,
        CancellationTokenSource debounce)
    {
        try
        {
            // selection and brushScrolled both fire throughout a drag. Waiting
            // for the final payload prevents Blazor from replacing Apex's SVG
            // while the browser still has an active drag operation against it.
            await Task.Delay(250, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(_navigatorUpdateDebounce, debounce))
            return;

        var fullRange = GetFullAvailableDateRange();
        if (!fullRange.Start.HasValue || !fullRange.End.HasValue)
            return;

        var selectedStart = DateTimeOffset
            .FromUnixTimeMilliseconds(Convert.ToInt64(Math.Floor(selectedMin)))
            .UtcDateTime.Date;
        var selectedEnd = DateTimeOffset
            .FromUnixTimeMilliseconds(Convert.ToInt64(Math.Ceiling(selectedMax)))
            .UtcDateTime.Date;

        if (selectedStart < fullRange.Start.Value.Date) selectedStart = fullRange.Start.Value.Date;
        if (selectedEnd > fullRange.End.Value.Date) selectedEnd = fullRange.End.Value.Date;
        if (selectedEnd < selectedStart ||
            (_startDate?.Date == selectedStart && _endDate?.Date == selectedEnd))
            return;

        _isApplyingNavigatorSelection = true;
        try
        {
            ClearChartZoomBaseline();
            _startDate = selectedStart;
            _endDate = selectedEnd;
            _dateRange = new DateRange(_startDate, _endDate);
            // Preserve the navigator component, its complete-history data and
            // the active brush rectangle. Only the filtered main aggregation
            // should change in response to moving the navigator window.
            var navigatorOptions = _navigatorOptions;
            await LoadDataAsync(refreshNavigator: false);
            BuildChartOptions();
            _navigatorOptions = navigatorOptions;
            await InvokeAsync(StateHasChanged);
            await RenderChart();
        }
        finally
        {
            _isApplyingNavigatorSelection = false;
            if (ReferenceEquals(_navigatorUpdateDebounce, debounce))
            {
                Interlocked.CompareExchange(ref _navigatorUpdateDebounce, null, debounce);
                debounce.Dispose();
            }
        }
    }

    private void ClearChartZoomBaseline()
    {
        _preZoomStartDate = null;
        _preZoomEndDate = null;
    }

    private (DateTime? Start, DateTime? End) GetFullAvailableDateRange()
    {
        if (!_useDataWarehouse && _parsedWorkbook != null)
        {
            var workbookDates = _parsedWorkbook.Behaviors
                .Where(record => record.Date.HasValue)
                .Select(record => record.Date!.Value.Date)
                .ToList();

            if (workbookDates.Count > 0)
                return (workbookDates.Min(), workbookDates.Max());
        }

        return (_viewModel?.GlobalMinDate?.Date, _viewModel?.GlobalMaxDate?.Date);
    }

