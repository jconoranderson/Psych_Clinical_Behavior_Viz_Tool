    private async Task OnVariableStateChanged()
    {
        await LoadDataAsync();
        BuildChartOptions();

        // Target selection changes the number and ordering of chart series.
        // Updating the existing Apex instance through a zero-series state can
        // corrupt its internal series arrays, so remount the chart instead.
        _chart = null;
        _chartRevision++;

        if (_hoveredTarget != null && !VisibleTargets.Contains(_hoveredTarget))
        {
            _hoveredPoint = null;
            _hoveredTarget = null;
            _hoveredSubcategories.Clear();
            _hoveredIntensities.Clear();
            _hoveredDurations.Clear();
        }

        await InvokeAsync(StateHasChanged);
    }

